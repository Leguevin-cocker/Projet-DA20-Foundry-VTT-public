<div class="noctis-item-sheet type-{{type}}">
  <header class="item-header">
    <img class="item-portrait" src="{{item.img}}" alt="" data-action="editImage" data-tooltip="{{localize "NOCTIS.ui.ChangerLImage"}}">
    <div class="item-title">
      <input class="item-name" type="text" name="name" value="{{item.name}}">
      <span class="item-type">{{typeLabel}}{{#if system.source}} · {{system.source}}{{/if}}</span>
    </div>
    {{#if isClan}}{{#if system.emblem}}<img class="item-emblem" src="{{system.emblem}}" alt="">{{/if}}{{/if}}
  </header>

  <div class="item-body">
    <div class="fields-grid">
      {{#if isClan}}
        <label><span>{{localize "NOCTIS.ui.Surnom"}}</span><input type="text" name="system.nickname" value="{{system.nickname}}"></label>
        <label><span>{{localize "NOCTIS.ui.Lignee"}}</span><input type="checkbox" name="system.isBloodline" {{#if system.isBloodline}}checked{{/if}}></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.DisciplinesDeClan2"}}</span><input type="text" name="system.disciplinesText" value="{{clanDisciplinesText}}" placeholder="{{localize "NOCTIS.ui.NomsDesDisciplinesSeparesParDes"}}"></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.Precision"}}</span><input type="text" name="system.disciplineNote" value="{{system.disciplineNote}}"></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.Faiblesse3"}}</span><textarea name="system.weakness" rows="4">{{system.weakness}}</textarea></label>
        <label><span>{{localize "NOCTIS.ui.ApparenceA0"}}</span><input type="checkbox" name="system.appearanceZero" {{#if system.appearanceZero}}checked{{/if}}></label>
        <label><span>{{localize "NOCTIS.ui.VoiesCourantes"}}</span><input type="text" name="system.roads" value="{{system.roads}}"></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.BlasonImage"}}</span><span class="file-pick"><input type="text" name="system.emblem" value="{{system.emblem}}"><a data-action="pickEmblem" data-tooltip="{{localize "NOCTIS.ui.ChoisirUneImage"}}"><i class="fa-solid fa-folder-open"></i></a></span></label>
        <label class="wide" data-tooltip="{{localize "NOCTIS.ui.FaiblesseMecaniqueLXpDeConscience"}}"><span>{{localize "NOCTIS.ui.XpDeMoraleDoublee"}}</span><input type="checkbox" name="flags.noctis.doubleConscienceXp" {{#if item.flags.noctis.doubleConscienceXp}}checked{{/if}}></label>
      {{/if}}

      {{#if isDiscipline}}
        <label data-tooltip="{{localize "NOCTIS.ui.IdentifiantQuiRelieClansVoiesEt" discKey=discKey}}"><span>{{localize "NOCTIS.ui.Cle"}}</span><input type="text" name="system.key" value="{{system.key}}" placeholder="{{discKey}}"></label>
        <label class="wide" data-tooltip="{{localize "NOCTIS.ui.SiLaDisciplineTientLUn"}}"><span>{{localize "NOCTIS.ui.RoleMecanique"}}</span><select name="system.mechanic">{{noctisOptions mechanicChoices system.mechanic}}</select></label>
        <label><span>{{localize "NOCTIS.ui.Niveau4"}}</span><input type="number" name="system.value" value="{{system.value}}" min="0" max="10"></label>
        <label><span>{{localize "NOCTIS.ui.VoieDeSorcellerie"}}</span><input type="checkbox" name="system.isPath" {{#if system.isPath}}checked{{/if}}></label>
        {{#if system.isPath}}
          <label><span>{{localize "NOCTIS.ui.DisciplineMere"}}</span><select name="system.parent">{{noctisOptions disciplineChoices system.parent}}</select></label>
          <label><span>{{localize "NOCTIS.ui.VoiePrimaire"}}</span><input type="checkbox" name="system.primary" {{#if system.primary}}checked{{/if}}></label>
        {{/if}}
        <label><span>{{localize "NOCTIS.ui.ToujoursDeClan"}}</span><input type="checkbox" name="system.inClan" {{#if system.inClan}}checked{{/if}}></label>
      {{/if}}

      {{#if isMerit}}
        <label><span>{{localize "NOCTIS.ui.Cout"}}</span><input type="number" name="system.cost" value="{{system.cost}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.CoutTexte"}}</span><input type="text" name="system.costText" value="{{system.costText}}" placeholder="{{localize "NOCTIS.ui.Ex1A5"}}"></label>
        <label><span>{{localize "NOCTIS.ui.Categorie"}}</span><select name="system.category">{{noctisOptions meritCategories system.category}}</select></label>
      {{/if}}

      {{#if isAbility}}
        <label><span>{{localize "NOCTIS.ui.Categorie"}}</span><select name="system.group">{{noctisOptions abilityGroups system.group}}</select></label>
        <label><span>{{localize "NOCTIS.ui.Niveau4"}}</span><input type="number" name="system.value" value="{{system.value}}" min="0" max="10"></label>
        <label><span>{{localize "NOCTIS.ui.Specialite3"}}</span><input type="text" name="system.spec" value="{{system.spec}}"></label>
      {{/if}}

      {{#if isRoad}}
        <label><span>{{localize "NOCTIS.ui.NomLatin"}}</span><input type="text" name="system.latin" value="{{system.latin}}"></label>
        <label><span>{{localize "NOCTIS.ui.SurnomDesAdeptes"}}</span><input type="text" name="system.nickname" value="{{system.nickname}}"></label>
        <label><span>{{localize "NOCTIS.ui.PremiereVertu"}}</span><select name="system.virtue1">{{noctisOptions virtue1 system.virtue1}}</select></label>
        <label><span>{{localize "NOCTIS.ui.DeuxiemeVertu"}}</span><select name="system.virtue2">{{noctisOptions virtue2 system.virtue2}}</select></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.Aura"}}</span><input type="text" name="system.aura" value="{{system.aura}}"></label>
        <label class="wide" data-tooltip="{{localize "NOCTIS.moral.AuraRollsTip"}}"><span>{{localize "NOCTIS.moral.AuraRollsLabel"}}</span><input type="text" name="system.auraRolls" value="{{system.auraRolls}}"></label>
        <label data-tooltip="{{localize "NOCTIS.aura.Color"}}"><span>{{localize "NOCTIS.aura.Color"}}</span><input type="color" name="system.auraColor" value="{{#if system.auraColor}}{{system.auraColor}}{{else}}#c9a35a{{/if}}"></label>
        <label><span>{{localize "NOCTIS.aura.Style"}}</span><select name="system.auraStyle">{{noctisOptions auraStyles system.auraStyle}}</select></label>
        <label data-tooltip="{{localize "NOCTIS.moral.CreedRequiredTip"}}"><span>{{localize "NOCTIS.moral.CreedRequired"}}</span><input type="checkbox" name="system.creedRequired" {{#if system.creedRequired}}checked{{/if}}></label>
      {{/if}}

      {{#if isWeapon}}
        <label><span>{{localize "NOCTIS.ui.Capacite"}}</span><select name="system.ability">{{noctisOptions weaponAbilities system.ability}}</select></label>
        <label><span>{{localize "NOCTIS.ui.AttributDAttaque"}}</span><select name="system.attribute">{{noctisOptions attributeChoices system.attribute}}</select></label>
        <label><span>{{localize "NOCTIS.ui.DegatsAttribut"}}</span><select name="system.damageAttribute">{{noctisOptions attributeChoices system.damageAttribute}}</select></label>
        <label><span>{{localize "NOCTIS.ui.DegatsBonus"}}</span><input type="number" name="system.damageBonus" value="{{system.damageBonus}}"></label>
        <label><span>{{localize "NOCTIS.ui.TypeDeDegats"}}</span><select name="system.damageType">{{noctisOptions damageTypes system.damageType}}</select></label>
        <label><span>{{localize "NOCTIS.ui.Difficulte3"}}</span><input type="number" name="system.difficulty" value="{{system.difficulty}}" min="2" max="10"></label>
        <label><span>{{localize "NOCTIS.ui.PorteeM"}}</span><input type="number" name="system.range" value="{{system.range}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.Dissimulation"}}</span><select name="system.conceal">{{noctisOptions concealment system.conceal}}</select></label>
        <label><span>{{localize "NOCTIS.ui.ForceMinimale"}}</span><input type="number" name="system.strength" value="{{system.strength}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.PerforationDArmure"}}</span><input type="number" name="system.armorPiercing" value="{{system.armorPiercing}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.DeuxMains"}}</span><input type="checkbox" name="system.twoHanded" {{#if system.twoHanded}}checked{{/if}}></label>
        <label data-tooltip="{{localize "NOCTIS.ui.TorcheBrandonHuileEnflammeeAvecLa"}}"><span>{{localize "NOCTIS.ui.FeuOuSoleil"}}</span><input type="checkbox" name="system.fire" {{#if system.fire}}checked{{/if}}></label>
        <label><span>{{localize "NOCTIS.ui.Equipee"}}</span><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.Notes"}}</span><input type="text" name="system.notes" value="{{system.notes}}"></label>
      {{/if}}

      {{#if isArmor}}
        <label><span>{{localize "NOCTIS.ui.Type"}}</span><select name="system.kind">{{noctisOptions armorKinds system.kind}}</select></label>
        <label><span>{{localize "NOCTIS.ui.NiveauDeProtection"}}</span><input type="number" name="system.rating" value="{{system.rating}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.PenaliteDexInit"}}</span><input type="number" name="system.penalty" value="{{system.penalty}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.DifficulteDeParade"}}</span><input type="number" name="system.parryDifficulty" value="{{system.parryDifficulty}}" min="2" max="10"></label>
        <label><span>{{localize "NOCTIS.ui.DifficultePourLAttaquant"}}</span><input type="number" name="system.attackDifficulty" value="{{system.attackDifficulty}}"></label>
        <label><span>{{localize "NOCTIS.ui.Portee"}}</span><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}></label>
      {{/if}}

      {{#if isGear}}
        <label><span>{{localize "NOCTIS.ui.Quantite"}}</span><input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>
        <label><span>{{localize "NOCTIS.ui.PorteBonusActifs"}}</span><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}></label>
      {{/if}}

      {{#if isRitual}}
        <label><span>{{localize "NOCTIS.ui.Niveau4"}}</span><input type="number" name="system.level" value="{{system.level}}" min="1" max="10"></label>
        <label><span>{{localize "NOCTIS.ui.Sorcellerie"}}</span><select name="system.sorcery">{{noctisOptions sorceries system.sorcery}}</select></label>
      {{/if}}

      <label class="wide"><span>{{localize "NOCTIS.ui.Source"}}</span><input type="text" name="system.source" value="{{system.source}}" placeholder="{{localize "NOCTIS.ui.ExSupplementMaison"}}"></label>
    </div>

    {{#if isClan}}
      <div class="clan-weakness-preview">{{{localize "NOCTIS.ui.Disciplines2" clanDisciplinesText=clanDisciplinesText}}}{{#if system.disciplineNote}} — {{system.disciplineNote}}{{/if}}</div>
    {{/if}}

    {{#if isDiscipline}}
      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.Pouvoirs"}}</h3>
      <table class="powers-editor">
        <thead><tr><th>{{localize "NOCTIS.ui.Niv"}}</th><th>{{localize "NOCTIS.ui.Nom"}}</th><th>{{localize "NOCTIS.ui.Attribut"}}</th><th>{{localize "NOCTIS.ui.Capacite"}}</th><th>{{localize "NOCTIS.ui.Diff"}}</th><th>{{localize "NOCTIS.ui.Cout"}}</th><th>{{localize "NOCTIS.ui.Duree"}}</th><th></th></tr></thead>
        <tbody>
          {{#each system.powers}}
            <tr>
              <td><input type="number" name="system.powers.{{@index}}.level" value="{{level}}" min="1" max="10"></td>
              <td><input type="text" name="system.powers.{{@index}}.name" value="{{name}}"></td>
              <td><select name="system.powers.{{@index}}.attribute">{{noctisOptions ../attributeChoices attribute}}</select></td>
              <td><select name="system.powers.{{@index}}.ability">{{noctisOptions ../abilityChoices ability}}</select></td>
              <td><input type="text" name="system.powers.{{@index}}.difficulty" value="{{difficulty}}"></td>
              <td><input type="text" name="system.powers.{{@index}}.cost" value="{{cost}}"></td>
              <td><input type="text" name="system.powers.{{@index}}.duration" value="{{duration}}" placeholder="{{localize "NOCTIS.ui.SceneTour"}}"></td>
              <td><a data-action="deleteRow" data-field="system.powers" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
            </tr>
            <tr class="summary-row"><td></td><td colspan="7"><textarea name="system.powers.{{@index}}.summary" rows="2" placeholder="{{localize "NOCTIS.ui.Resume"}}">{{summary}}</textarea></td></tr>
          {{/each}}
        </tbody>
      </table>
      <a class="add-row" data-action="addRow" data-field="system.powers"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Pouvoir"}}</a>
    {{/if}}

    {{#if isMerit}}
      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.Niveaux"}}</h3>
      <p class="hint">{{localize "NOCTIS.ui.FacultatifPourUnAtoutOuUn"}}</p>
      <table class="sins-editor levels-editor">
        <thead><tr><th>{{localize "NOCTIS.ui.Cout"}}</th><th>{{localize "NOCTIS.ui.EffetDeCeNiveau"}}</th><th></th></tr></thead>
        {{#each system.levels}}
          <tr>
            <td><input type="number" name="system.levels.{{@index}}.value" value="{{value}}" min="0"></td>
            <td><input type="text" name="system.levels.{{@index}}.text" value="{{text}}"></td>
            <td><a data-action="deleteRow" data-field="system.levels" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
          </tr>
        {{/each}}
      </table>
      <a class="add-row" data-action="addRow" data-field="system.levels"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Niveau5"}}</a>
    {{/if}}

    {{#if isRoad}}
      <h3 class="noctis-subsection">{{localize "NOCTIS.moral.AuraTextLabel"}}</h3>
      <textarea class="plain-text small" name="system.auraText" rows="3" placeholder="{{localize "NOCTIS.moral.AuraTextPlaceholder"}}">{{system.auraText}}</textarea>

      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.HierarchieDesPeches"}}</h3>
      <p class="hint">{{localize "NOCTIS.moral.SinsHint"}}</p>
      <table class="sins-editor">
        {{#each system.sins}}
          <tr>
            <td><input type="number" name="system.sins.{{@index}}.level" value="{{level}}" min="1" max="10"></td>
            <td><input type="text" name="system.sins.{{@index}}.sin" value="{{sin}}" placeholder="{{localize "NOCTIS.moral.SinPlaceholder"}}"></td>
            <td><input type="text" name="system.sins.{{@index}}.why" value="{{why}}" placeholder="{{localize "NOCTIS.moral.WhyPlaceholder"}}"></td>
            <td><a data-action="deleteRow" data-field="system.sins" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
          </tr>
        {{/each}}
      </table>
      <a class="add-row" data-action="addRow" data-field="system.sins"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Peche"}}</a>

      <h3 class="noctis-subsection">{{localize "NOCTIS.moral.Ethics"}}</h3>
      <textarea class="plain-text small" name="system.ethicsText" rows="4" placeholder="{{localize "NOCTIS.moral.EthicsPlaceholder"}}">{{ethicsText}}</textarea>

      <h3 class="noctis-subsection">{{localize "NOCTIS.moral.Creeds"}}</h3>
      <p class="hint">{{localize "NOCTIS.moral.CreedsHint"}}</p>
      {{#each creeds}}
        <fieldset class="creed-editor">
          <legend><i class="fa-solid fa-book-bible"></i> {{#if name}}{{name}}{{else}}{{localize "NOCTIS.moral.Creed"}} {{n}}{{/if}}
            <a data-action="deleteRow" data-field="system.creeds" data-idx="{{idx}}" data-tooltip="{{localize "NOCTIS.moral.DeleteCreed"}}"><i class="fa-solid fa-trash"></i></a></legend>
          <div class="fields-grid">
            <label class="wide"><span>{{localize "NOCTIS.moral.Name"}}</span><input type="text" name="system.creeds.{{idx}}.name" value="{{name}}"></label>
            <label><span>{{localize "NOCTIS.ui.PremiereVertu"}}</span><select name="system.creeds.{{idx}}.virtue1">{{noctisOptions @root.virtue1 virtue1}}</select></label>
            <label><span>{{localize "NOCTIS.ui.DeuxiemeVertu"}}</span><select name="system.creeds.{{idx}}.virtue2">{{noctisOptions @root.virtue2 virtue2}}</select></label>
            <label class="wide"><span>{{localize "NOCTIS.moral.Summary"}}</span><input type="text" name="system.creeds.{{idx}}.summary" value="{{summary}}"></label>
          </div>
          <label class="stack"><span>{{localize "NOCTIS.moral.Ethics"}}</span><textarea class="plain-text small" name="system.creeds.{{idx}}.ethicsText" rows="3" placeholder="{{localize "NOCTIS.moral.EthicsPlaceholder"}}">{{ethicsText}}</textarea></label>
          <span class="stack-label">{{localize "NOCTIS.moral.CreedSins"}}</span>
          <table class="sins-editor">
            {{#each sins}}
              <tr>
                <td><input type="number" name="system.creeds.{{../idx}}.sins.{{@index}}.level" value="{{level}}" min="1" max="10"></td>
                <td><input type="text" name="system.creeds.{{../idx}}.sins.{{@index}}.sin" value="{{sin}}" placeholder="{{localize "NOCTIS.moral.SinPlaceholder"}}"></td>
                <td><input type="text" name="system.creeds.{{../idx}}.sins.{{@index}}.why" value="{{why}}" placeholder="{{localize "NOCTIS.moral.WhyPlaceholder"}}"></td>
                <td><a data-action="deleteRow" data-field="system.creeds.{{../idx}}.sins" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
              </tr>
            {{/each}}
          </table>
          <a class="add-row" data-action="addRow" data-field="system.creeds.{{idx}}.sins"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Peche"}}</a>
        </fieldset>
      {{/each}}
      <a class="add-row" data-action="addRow" data-field="system.creeds"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.moral.Creed"}}</a>
    {{/if}}

    <h3 class="noctis-subsection">{{localize "NOCTIS.ui.Description"}}</h3>
    <textarea class="plain-text" name="descriptionText" rows="8" {{#unless editable}}disabled{{/unless}}>{{descriptionText}}</textarea>

    <details class="automation" {{#if system.bonuses.length}}open{{/if}}>
      <summary><i class="fa-solid fa-gears"></i> {{localize "NOCTIS.ui.Automatisation"}}</summary>
      <h4>{{localize "NOCTIS.ui.BonusProposesDansLaFenetreDe"}}</h4>
      <p class="hint">{{localize "NOCTIS.ui.ExSensCommun1DeQuand"}}</p>
      <table class="bonus-editor">
        <thead><tr><th>{{localize "NOCTIS.ui.Libelle"}}</th><th>{{localize "NOCTIS.ui.SAppliqueA"}}</th><th>{{localize "NOCTIS.ui.Des4"}}</th><th>{{localize "NOCTIS.ui.Diff"}}</th><th>{{localize "NOCTIS.ui.Auto"}}</th><th></th></tr></thead>
        {{#each system.bonuses}}
          <tr>
            <td><input type="text" name="system.bonuses.{{@index}}.label" value="{{label}}"><input type="hidden" name="system.bonuses.{{@index}}.id" value="{{id}}"></td>
            <td><select name="system.bonuses.{{@index}}.target">{{noctisOptions ../targets target}}</select></td>
            <td><input type="number" name="system.bonuses.{{@index}}.dice" value="{{dice}}"></td>
            <td><input type="number" name="system.bonuses.{{@index}}.difficulty" value="{{difficulty}}"></td>
            <td><input type="checkbox" name="system.bonuses.{{@index}}.auto" {{#if auto}}checked{{/if}}></td>
            <td><a data-action="deleteRow" data-field="system.bonuses" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
          </tr>
        {{/each}}
      </table>
      <a class="add-row" data-action="addRow" data-field="system.bonuses"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.BonusDeJet"}}</a>

      <h4>{{localize "NOCTIS.ui.ModificateursPermanentsDeLaFiche"}}</h4>
      <table class="modifier-editor">
        {{#each system.modifiers}}
          <tr>
            <td><select name="system.modifiers.{{@index}}.target">{{noctisOptions ../modifierTargets target}}</select></td>
            <td><input type="number" name="system.modifiers.{{@index}}.value" value="{{value}}"></td>
            <td><a data-action="deleteRow" data-field="system.modifiers" data-idx="{{@index}}"><i class="fa-solid fa-trash"></i></a></td>
          </tr>
        {{/each}}
      </table>
      <a class="add-row" data-action="addRow" data-field="system.modifiers"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Modificateur"}}</a>
    </details>
  </div>
</div>
