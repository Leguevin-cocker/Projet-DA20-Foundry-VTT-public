<div class="noctis-roll-form">
  <nav class="roll-tabs">
    <a data-action="setMode" data-mode="simple" class="{{#unless opposed}}active{{/unless}}"><i class="fa-solid fa-dice-d10"></i> {{localize "NOCTIS.ui.JetSimple"}}</a>
    <a data-action="setMode" data-mode="opposed" class="{{#if opposed}}active{{/if}}"><i class="fa-solid fa-khanda"></i> {{localize "NOCTIS.ui.JetOppose"}}</a>
  </nav>
  <input type="hidden" name="mode" value="{{#if opposed}}opposed{{else}}simple{{/if}}">
  <div class="opposed-box {{#unless opposed}}hidden{{/unless}}">
    {{#unless targets.hasToken}}<p class="warn">{{localize "NOCTIS.ui.AucunJetonDeSurLaScene" name=actor.name}}</p>{{/unless}}
    <div class="target-row">
      <label><span>{{localize "NOCTIS.ui.CorpsACorps"}}</span><select name="target.melee" class="target-select"><option value="">—</option>{{#each targets.melee}}<option value="{{tokenUuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label><span>{{localize "NOCTIS.ui.Proche25Cases"}}</span><select name="target.close" class="target-select"><option value="">—</option>{{#each targets.close}}<option value="{{tokenUuid}}" {{#if selected}}selected{{/if}}>{{name}} ({{cells}})</option>{{/each}}</select></label>
      <label><span>{{localize "NOCTIS.ui.Distance"}}</span><select name="target.far" class="target-select"><option value="">—</option>{{#each targets.far}}<option value="{{tokenUuid}}" {{#if selected}}selected{{/if}}>{{name}} ({{cells}})</option>{{/each}}</select></label>
    </div>
    {{#if maneuvers}}
    <div class="maneuver-row">
      <label class="grow"><span>{{localize "NOCTIS.ui.Manuvre"}}</span>
        <select name="maneuver">
          {{#each maneuvers.groups}}<optgroup label="{{label}}">{{#each options}}<option value="{{key}}" {{#if (noctisEq key ../../maneuvers.default)}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
        </select>
      </label>
      <i class="fa-solid fa-circle-info maneuver-info" data-maneuver-info data-tooltip-direction="LEFT"></i>
    </div>
    <p class="maneuver-short" data-maneuver-short></p>
    <div class="situation-row">
      <label data-tooltip="{{localize "NOCTIS.ui.ViserUnePartiePreciseDuCorps"}}"><span>{{localize "NOCTIS.ui.Ciblage2"}}</span>
        <select name="targeting">{{#each targeting}}<option value="{{key}}" data-tip="{{tip}}">{{label}}</option>{{/each}}</select>
      </label>
      <label data-tooltip="{{localize "NOCTIS.ui.DeFlanc1DeDeDos"}}"><span>{{localize "NOCTIS.ui.Position"}}</span>
        <select name="position">{{#each positions}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
      </label>
      {{#if maneuvers.ranged}}
      <label data-tooltip="{{localize "NOCTIS.ui.CouvertDeLaCibleDifficulte1"}}"><span>{{localize "NOCTIS.ui.Couvert"}}</span>
        <select name="cover">{{#each covers}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
      </label>
      <label data-tooltip="{{localize "NOCTIS.ui.1DeParTourPasseA" perception=perception}}"><span>{{localize "NOCTIS.ui.Visee"}}</span>
        <select name="aim">{{#each aimChoices}}<option value="{{this}}">{{#if this}}{{localize "NOCTIS.ui.TourSDeS" value=this}}{{else}}{{localize "NOCTIS.ui.Aucune"}}{{/if}}</option>{{/each}}</select>
      </label>
      {{else}}
      <label data-tooltip="{{localize "NOCTIS.ui.1EnDifficulteParAdversaireAu"}}"><span>{{localize "NOCTIS.ui.Adversaires"}}</span>
        <select name="opponents"><option value="1">{{localize "NOCTIS.ui.UnSeul"}}</option><option value="2">{{localize "NOCTIS.ui.21Diff"}}</option><option value="3">{{localize "NOCTIS.ui.32Diff"}}</option><option value="4">{{localize "NOCTIS.ui.43Diff"}}</option><option value="5">{{localize "NOCTIS.ui.5EtPlus4Diff"}}</option></select>
      </label>
      {{/if}}
    </div>
    {{/if}}
    <p class="hint">{{#if inCombat}}{{{localize "NOCTIS.ui.ActionsRestantesAttaquesPossibles" actions=combat.actions actionsMax=combat.actionsMax attacksLeft=combat.attacksLeft}}} {{/if}}{{localize "NOCTIS.ui.LaCibleSeDefendSiElle"}}{{#unless weapon}} {{localize "NOCTIS.ui.SansArmeAttaqueAMainsNues"}}{{/unless}}</p>
  </div>
  {{#if weapon}}
    <div class="weapon-line"><img src="{{weapon.img}}" alt=""> {{{localize "NOCTIS.ui.Degats4" name=weapon.name}}} {{#if weapon.system.damageAttribute}}{{localize "NOCTIS.ui.Force"}} {{/if}}{{weapon.system.damageBonus}} ({{weaponDamageType}})</div>
  {{/if}}

  <div class="pool-row">
    <label><span>{{localize "NOCTIS.ui.Trait"}}</span>
      <select name="trait1">
        <option value="none">—</option>
        {{#each traits1}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
      </select>
    </label>
    <span class="plus">+</span>
    <label><span>{{localize "NOCTIS.ui.Trait"}}</span>
      <select name="trait2">
        <option value="none">—</option>
        {{#each traits2}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}
      </select>
    </label>
  </div>

  <div class="row-2">
    <label><span>{{localize "NOCTIS.ui.DesEnPlusEnMoins"}}</span>
      <span class="stepper">
        <button type="button" data-action="step" data-field="bonusDice" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
        <input type="number" name="bonusDice" value="{{preset.bonusDice}}" min="-20" max="20">
        <button type="button" data-action="step" data-field="bonusDice" data-delta="1"><i class="fa-solid fa-plus"></i></button>
      </span>
    </label>
    <label class="difficulty"><span>{{localize "NOCTIS.ui.Difficulte3"}}</span>
      <span class="stepper">
        <button type="button" data-action="diffDown"><i class="fa-solid fa-minus"></i></button>
        <input type="number" name="difficulty" value="{{preset.difficulty}}" min="2" max="10">
        <button type="button" data-action="diffUp"><i class="fa-solid fa-plus"></i></button>
      </span>
    </label>
  </div>

  <div class="options">
    <label class="check"><input type="checkbox" name="specialty"> {{localize "NOCTIS.ui.Specialite3"}} <small data-specs></small></label>
    <div class="stepper-line {{#unless willpowerTemp}}disabled{{/unless}}">
      <span class="stepper small">
        <button type="button" data-action="step" data-field="willpower" data-delta="-1" {{#unless willpowerTemp}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
        <input type="number" name="willpower" value="0" min="0" max="{{#if willpowerTemp}}1{{else}}0{{/if}}" readonly>
        <button type="button" data-action="step" data-field="willpower" data-delta="1" {{#unless willpowerTemp}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
      </span>
      <span>{{{localize "NOCTIS.ui.VolonteDepensee1ReussiteAutomatique1" willpowerTemp=willpowerTemp}}}</span>
    </div>
    {{#if woundPenalty}}
      <label class="check"><input type="checkbox" name="ignoreWounds" {{#unless willpowerTemp}}disabled{{/unless}}> {{localize "NOCTIS.ui.IgnorerLesBlessuresDesPour1" woundPenalty=woundPenalty}}</label>
    {{/if}}
    <label class="inline"><span>{{localize "NOCTIS.ui.ActionMultipleNDAction"}}</span>
      <select name="multi"><option value="0">{{localize "NOCTIS.ui.ActionUnique"}}</option><option value="1">{{localize "NOCTIS.ui.1reDePlusieurs1De1"}}</option><option value="2">{{localize "NOCTIS.ui.2e2Des2"}}</option><option value="3">{{localize "NOCTIS.ui.3e3Des3"}}</option><option value="4">{{localize "NOCTIS.ui.4e4Des4"}}</option></select>
    </label>
  </div>

  {{#if usesBlood}}
    <div class="boost-row">
      <span>{{{localize "NOCTIS.ui.AmplifierParLeSangPts" blood=blood}}}</span>
      {{#each boosts}}<label class="mini"><span>{{label}}</span>
        <span class="stepper small">
          <button type="button" data-action="step" data-field="boost.{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
          <input type="number" name="boost.{{key}}" value="0" min="0" max="{{../boostMax}}">
          <button type="button" data-action="step" data-field="boost.{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></button>
        </span></label>{{/each}}
    </div>
  {{/if}}

  {{#if hasBonuses}}
    <fieldset class="bonuses">
      <legend>{{localize "NOCTIS.ui.BonusEtMalusDeLaFiche"}}</legend>
      {{#each bonuses}}
        <label class="check bonus-row" data-bonus-target="{{target}}" data-auto="{{auto}}">
          <input type="checkbox" name="bonus.{{key}}" {{#if auto}}checked{{/if}}>
          <span class="b-label">{{#if label}}{{label}}{{else}}{{source}}{{/if}}</span>
          <span class="b-val">{{#if dice}}{{noctisSigned dice}} {{localize "NOCTIS.ui.DeS"}}{{/if}}{{#if difficulty}} {{localize "NOCTIS.ui.Diff3"}} {{noctisSigned difficulty}}{{/if}}</span>
          <small class="b-src">{{source}}</small>
        </label>
      {{/each}}
    </fieldset>
  {{/if}}

  <div class="summary">
    <div data-summary></div>
    <div class="parts" data-parts></div>
  </div>

  <div class="footer-row">
    <select name="rollMode">{{#each rollModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    <button type="button" data-action="cancel"><i class="fa-solid fa-xmark"></i> {{localize "NOCTIS.ui.Annuler"}}</button>
    <button type="submit" class="roll-btn"><i class="fa-solid fa-dice-d10"></i> {{localize "NOCTIS.ui.Lancer"}}</button>
  </div>
</div>
