<div class="noctis-card beast-card beast-{{kind}} stage-{{stage}}">
  <div class="card-frame">
    <header class="beast-head">
      <img src="{{img}}" alt="">
      <div>
        <h3>{{#if isFrenzy}}La Bête s'éveille{{else}}La Panique{{/if}}</h3>
        <p><b>{{name}}</b> · {{kindLabel}}{{#if reason}} — {{reason}}{{/if}}</p>
      </div>
      <i class="beast-icon fa-solid {{#if isFrenzy}}fa-face-angry{{else}}fa-fire{{/if}}"></i>
    </header>

    <p class="beast-pool">{{poolLabel}} · difficulté <b>{{difficulty}}</b>{{#if accumulated}} · réussites cumulées <b>{{accumulated}}/5</b>{{/if}}
      <span class="beast-gm" data-beast-gm>{{#if open}}<a data-beast-step="diffDown" data-tooltip="Baisser la difficulté">−</a><a data-beast-step="diffUp" data-tooltip="Monter la difficulté">+</a>{{/if}}</span>
    </p>
    {{#if accumulated}}<div class="beast-meter"><span style="width: {{noctisPct accumulated 5}}%"></span></div>{{/if}}

    {{#each rolls}}
      <div class="beast-roll">
        <div class="dice">{{#each faces}}<span class="d10 {{cls}}">{{value}}</span>{{/each}}</div>
        <small>{{pool}} dés, diff. {{difficulty}}{{#if evil}} (acte maléfique){{/if}} → {{#if botch}}échec critique{{else}}{{successes}} réussite(s){{/if}}</small>
      </div>
    {{/each}}

    {{#if instinct}}{{#if open}}<p class="beast-note">Instinct : un vampire qui suit l'Instinct succombe toujours à la frénésie.</p>{{/if}}{{/if}}

    {{#if open}}
      <div class="card-buttons" data-beast-owner>
        {{#unless instinct}}
          <button type="button" data-beast-step="roll"><i class="fa-solid fa-dice-d10"></i> {{#if accumulated}}Nouveau jet{{else}}Résister{{/if}} ({{pool}} dés)</button>
          {{#if evilDifficulty}}<button type="button" data-beast-step="evil" data-tooltip="Pour empêcher un acte authentiquement maléfique : difficulté 9 − Conscience/Conviction"><i class="fa-solid fa-cross"></i> Contre un acte maléfique (diff. {{evilDifficulty}})</button>{{/if}}
        {{/unless}}
        <button type="button" data-beast-step="succumb" class="succumb"><i class="fa-solid fa-skull"></i> Céder à la Bête</button>
      </div>
      <p class="clash-pending" data-beast-pending>En attente de {{name}}…</p>
    {{/if}}

    {{#if outcome}}
      <div class="outcome {{#if (noctisEq stage 'resisted')}}success{{else}}{{#if (noctisEq stage 'delayed')}}partial{{else}}failure{{/if}}{{/if}}"><span class="label">{{outcome}}</span></div>
    {{/if}}
  </div>
</div>
