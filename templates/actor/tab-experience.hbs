<section class="tab tab-experience {{tab.cssClass}}" data-tab="experience">
  <div class="xp-summary">
    <div class="xp-card gained"><span class="n">{{system.experience.total}}</span><span class="l">gagnés</span></div>
    <div class="xp-card spent"><span class="n">{{system.experience.spent}}</span><span class="l">dépensés</span></div>
    <div class="xp-card available"><span class="n">{{system.experience.available}}</span><span class="l">disponibles</span></div>
  </div>

  {{#if xpSegments.length}}
  <div class="xp-breakdown">
    <div class="xp-bar">{{#each xpSegments}}<span class="seg {{cls}}" style="width: {{pct}}%" data-tooltip="{{tip}}"></span>{{/each}}</div>
    <div class="ledger-legend">{{#each xpSegments}}<span><i class="sw {{cls}}"></i> {{label}} <b>{{amount}}</b></span>{{/each}}</div>
  </div>
  {{/if}}

  <div class="xp-actions">
    <button type="button" data-action="xpAdd"><i class="fa-solid fa-plus"></i> Gain d'expérience</button>
    <button type="button" data-action="xpSpend"><i class="fa-solid fa-pen-to-square"></i> Dépense / ajout manuel</button>
  </div>
  <p class="hint">
    {{#if creationDone}}
      {{#if locked}}Fiche verrouillée : cliquez sur un point vide pour acheter le niveau suivant. Le coût est calculé selon le tableau des coûts et la ligne s'ajoute au journal (payante ou gratuite).{{else}}Édition libre : les changements de points ne sont pas inscrits au journal.{{/if}}
    {{else}}
      Personnage en création : les points se répartissent librement. Terminez la création (<i class="fa-solid fa-hourglass-half"></i> en haut de la fiche) pour que chaque progression passe par l'expérience.
    {{/if}}
  </p>

  <h2 class="noctis-section"><span>Journal</span></h2>
  {{#if xpLog.length}}
  <table class="xp-log">
    <thead><tr><th>Date</th><th>Libellé</th><th>Catégorie</th><th>XP</th><th>Type</th><th></th></tr></thead>
    <tbody>
      {{#each xpLog}}
        <tr class="{{kind}} {{#if free}}free{{/if}}" data-entry-id="{{id}}">
          <td class="date">{{date}}</td>
          <td class="label">{{label}}{{#if note}}<div class="note">{{note}}</div>{{/if}}</td>
          <td class="cat">{{categoryLabel}}</td>
          <td class="amount">{{sign}}{{amount}}</td>
          <td class="kind">
            {{#if (noctisEq kind "gain")}}<span class="badge gain">Gain</span>
            {{else}}<a class="badge {{#if free}}free{{else}}paid{{/if}}" data-action="xpToggleFree" data-tooltip="Basculer gratuit / payant">{{#if free}}Gratuit{{else}}Payant{{/if}}</a>{{/if}}
          </td>
          <td class="ctrl"><a data-action="xpDelete" data-tooltip="Supprimer la ligne"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
    <p class="empty">Aucune entrée pour l'instant.</p>
  {{/if}}

  {{#if creationLog}}
  <details class="xp-costs xp-creation">
    <summary>Création du personnage (mode {{creationLog.mode}})</summary>
    {{#each creationLog.sections}}
      <h4>{{title}} <em>{{rule}}</em></h4>
      <table>
        {{#each rows}}<tr><td class="lbl">{{label}}</td><td class="pts">{{points}}</td><td class="det">{{detail}}</td></tr>{{/each}}
      </table>
    {{/each}}
    <h4>Points de bonus <em>{{creationLog.bonusSpent}} / {{creationLog.bonusTotal}} dépensés{{#if creationLog.flawGain}} (dont {{creationLog.flawGain}} des handicaps){{/if}}</em></h4>
    {{#if creationLog.bonus.length}}
    <table>
      {{#each creationLog.bonus}}<tr><td class="lbl">{{label}}</td><td class="det">{{kind}}{{#if detail}} · {{detail}}{{/if}}</td><td class="pts">{{#if (noctisGt cost 0)}}−{{cost}}{{else}}+{{noctisAbs cost}}{{/if}}</td></tr>{{/each}}
    </table>
    {{else}}<p class="hint">Aucun point de bonus dépensé.</p>{{/if}}
    <h4>Résultat</h4>
    <table>
      {{#each creationLog.derived}}<tr><td class="lbl">{{label}}</td><td class="pts">{{value}}</td><td></td></tr>{{/each}}
    </table>
  </details>
  {{/if}}

  <details class="xp-costs">
    <summary>Coûts en expérience</summary>
    <table>
      <tr><td>Domaine d'expertise (spécialité)</td><td>1</td></tr>
      <tr><td>Nouvelle capacité</td><td>3</td></tr>
      <tr><td>Nouvelle discipline</td><td>10</td></tr>
      <tr><td>Nouvelle voie de sorcellerie</td><td>7</td></tr>
      <tr><td>Rituel de sorcellerie de sang</td><td>niveau × 2</td></tr>
      <tr><td>Attribut</td><td>niveau actuel × 4</td></tr>
      <tr><td>Capacité</td><td>niveau actuel × 2</td></tr>
      <tr><td>Discipline de clan</td><td>niveau actuel × 5</td></tr>
      <tr><td>Autre discipline</td><td>niveau actuel × 7</td></tr>
      <tr><td>Voie secondaire</td><td>niveau actuel × 4</td></tr>
      <tr><td>Vertu*</td><td>niveau actuel × 2</td></tr>
      <tr><td>Volonté</td><td>niveau actuel</td></tr>
      <tr><td>Voie</td><td>niveau actuel × 2</td></tr>
    </table>
    <p class="hint">* Augmenter une vertu avec de l'XP n'augmente pas les traits qui en dépendent. Aucun trait ne peut gagner plus d'un point par scénario.</p>
  </details>
</section>
