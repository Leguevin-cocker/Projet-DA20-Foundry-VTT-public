<section class="tab tab-combat {{tab.cssClass}}" data-tab="combat">
  <div class="combat-summary">
    <div class="stat-card actions-card {{#unless system.combat.actions}}empty{{/unless}}" data-tooltip="{{localize "NOCTIS.ui.ActionsRestantesCeTourAttaquerCoute"}}">
      <span class="stat-label">{{localize "NOCTIS.ui.Actions"}}</span><span class="stat-value">{{system.combat.actions}}<small>/{{system.combat.actionsMax}}</small></span>
      <span class="stat-sub">{{localize "NOCTIS.ui.Attaques" attacksLeft=system.combat.attacksLeft}}{{#if system.combat.celerityActive}} {{localize "NOCTIS.ui.Velocite" celerityActive=system.combat.celerityActive}}{{/if}}{{#if system.combat.defensePenalty}} {{localize "NOCTIS.ui.DeSALAttaque" defensePenalty=system.combat.defensePenalty}}{{/if}}</span>
      <span class="stat-btns">
        {{#if system.speed.celerity}}<a data-action="celerity" data-tooltip="{{localize "NOCTIS.ui.ActiverLaVelocite1Sang1"}}"><i class="fa-solid fa-bolt"></i></a>{{/if}}
        <a data-action="resetActions" data-tooltip="{{localize "NOCTIS.ui.RemettreLesActionsDuTour"}}"><i class="fa-solid fa-rotate"></i></a>
      </span>
    </div>
    <div class="stat-card speed-card" data-tooltip="{{localize "NOCTIS.ui.MetresParTourMarche7Trot"}}{{#if system.speed.celerity}} {{localize "NOCTIS.ui.Pour1SangVitessePendantUn" burst=system.speed.burst}}{{/if}}">
      <span class="stat-label">{{localize "NOCTIS.ui.Vitesse"}}</span><span class="stat-value">{{system.speed.run}}<small> m</small></span>
      <span class="stat-sub">{{localize "NOCTIS.ui.MarcheTrot" walk=system.speed.walk trot=system.speed.trot}}</span>
    </div>
    <div class="stat-card" data-action="rollInitiative" data-tooltip="{{localize "NOCTIS.ui.LancerLInitiativeDexteriteAstuceVelocite"}}">
      <span class="stat-label">{{localize "NOCTIS.ui.Initiative"}}</span><span class="stat-value">{{system.initiative.value}}</span><span class="stat-sub"><i class="fa-solid fa-dice-d10"></i> + 1d10</span>
    </div>
    <div class="stat-card soak" data-action="rollSoak" data-type="bashing" data-tooltip="{{localize "NOCTIS.ui.JetDAbsorptionContreLesDegats"}}">
      <span class="stat-label">{{localize "NOCTIS.ui.AbsorptionC"}}</span><span class="stat-value">{{system.soak.bashing}}</span><span class="stat-sub">{{localize "NOCTIS.ui.Contondants"}}</span>
    </div>
    <div class="stat-card soak" data-action="rollSoak" data-type="lethal" data-tooltip="{{localize "NOCTIS.ui.JetDAbsorptionContreLesDegats2"}}">
      <span class="stat-label">{{localize "NOCTIS.ui.AbsorptionL"}}</span><span class="stat-value">{{system.soak.lethal}}</span><span class="stat-sub">{{localize "NOCTIS.ui.Letaux"}}</span>
    </div>
    <div class="stat-card soak" data-action="rollSoak" data-type="aggravated" data-tooltip="{{localize "NOCTIS.ui.JetDAbsorptionContreLesDegats3"}}">
      <span class="stat-label">{{localize "NOCTIS.ui.AbsorptionA"}}</span><span class="stat-value">{{system.soak.aggravated}}</span><span class="stat-sub">{{localize "NOCTIS.ui.Aggraves"}}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">{{localize "NOCTIS.ui.Armure"}}</span><span class="stat-value">{{system.armorRating}}</span><span class="stat-sub">{{localize "NOCTIS.ui.Penalite" armorPenalty=system.armorPenalty}}</span>
    </div>
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Sante2"}}</span></h2>
  <div class="health-panel">
    <table class="health-table">
      {{#each system.health.track}}
        <tr class="{{state}}"><td class="hl-label">{{label}}</td><td class="hl-pen">{{#if penalty}}{{penalty}}{{/if}}</td><td><span class="hbox {{state}}" data-action="healthClick" data-health-index="{{index}}"></span></td></tr>
      {{/each}}
    </table>
    <div class="health-actions">
      <p class="counts">
        <span class="c">{{localize "NOCTIS.ui.ContondantS" bashing=system.health.bashing}}</span>
        <span class="l">{{localize "NOCTIS.ui.XLetalAux" lethal=system.health.lethal}}</span>
        <span class="a">{{localize "NOCTIS.ui.AggraveS" aggravated=system.health.aggravated}}</span>
      </p>
      <button type="button" data-action="takeDamage"><i class="fa-solid fa-heart-crack"></i> {{localize "NOCTIS.ui.SubirDesDegatsAvecAbsorption"}}</button>
      <div class="btn-row">
        <button type="button" data-action="healthClear" data-type="bashing" data-tooltip="{{localize "NOCTIS.ui.RetirerUnNiveauContondant"}}"><i class="fa-solid fa-minus"></i> C</button>
        <button type="button" data-action="healthClear" data-type="lethal" data-tooltip="{{localize "NOCTIS.ui.RetirerUnNiveauLetal"}}"><i class="fa-solid fa-minus"></i> L</button>
        <button type="button" data-action="healthClear" data-type="aggravated" data-tooltip="{{localize "NOCTIS.ui.RetirerUnNiveauAggrave"}}"><i class="fa-solid fa-minus"></i> A</button>
      </div>
      {{#if usesBlood}}
        <h4>{{localize "NOCTIS.ui.LeSang"}}</h4>
        <div class="btn-row">
          <button type="button" data-action="bloodHeal" data-tooltip="{{localize "NOCTIS.ui.1PointDeSangSoigneUn"}}"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.Soigner1"}}</button>
          {{#if isVampire}}<button type="button" data-action="bloodHealAgg" data-tooltip="{{localize "NOCTIS.ui.5PointsDeSangEtUn"}}"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.Aggrave5"}}</button>{{/if}}
        </div>
        <div class="btn-row">
          {{#each boostList}}<button type="button" data-action="bloodBoost" data-attr="{{key}}" data-tooltip="{{localize "NOCTIS.ui.1PointDeSang1En" label=label}}">+1 {{label}}{{#if boost}} <b>(+{{boost}})</b>{{/if}}</button>{{/each}}
        </div>
        <div class="btn-row">
          <button type="button" data-action="endScene" data-tooltip="{{localize "NOCTIS.ui.RetireLesAmplificationsDeSang"}}"><i class="fa-solid fa-hourglass-end"></i> {{localize "NOCTIS.ui.FinDeScene"}}</button>
          {{#if isVampire}}<button type="button" data-action="nightfall" data-tooltip="{{localize "NOCTIS.ui.Reveil1Sang1Volonte"}}"><i class="fa-solid fa-moon"></i> {{localize "NOCTIS.ui.Reveil"}}</button>{{/if}}
        </div>
      {{/if}}
    </div>
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtatsEtBete"}}</span></h2>
  <div class="state-panel">
    <div class="state-chips">
      {{#each statusChoices}}
        <a class="state-chip {{#if active}}on{{/if}} {{#if auto}}auto{{/if}}" {{#unless auto}}data-action="toggleStatus" data-status="{{id}}"{{/unless}} data-tooltip="{{name}} — {{tip}}{{#if auto}} {{localize "NOCTIS.ui.Automatique"}}{{/if}}"><img src="{{img}}" alt=""><span>{{name}}</span></a>
      {{/each}}
    </div>
    {{#if isVampire}}
    <div class="beast-box {{#if beastActive}}raging{{/if}}">
      {{#if beastActive}}
        <p><i class="fa-solid fa-face-angry"></i> {{{localize "NOCTIS.ui.LaBeteTientLesRenes" beastActive=beastActive}}}{{#if system.health.frenzyIgnores}} {{localize "NOCTIS.ui.LesPenalitesDeBlessuresSontIgnorees"}}{{/if}}</p>
        <div class="btn-row">
          <button type="button" data-action="beastLucid" data-tooltip="{{localize "NOCTIS.ui.1PointDeVolonteUnTour"}}"><i class="fa-solid fa-shield-heart"></i> {{localize "NOCTIS.ui.UnTourDeLucidite1Volonte"}}</button>
          <button type="button" data-action="beastEnd" data-tooltip="{{localize "NOCTIS.ui.LaCrisePasseEnGeneralAu"}}"><i class="fa-solid fa-dove"></i> {{localize "NOCTIS.ui.FinDeLaCrise"}}</button>
        </div>
      {{else}}
        <p class="hint">{{localize "NOCTIS.ui.MaitriseDeSoi" value=system.virtues.selfcontrol.value}}{{#if (noctisGt system.virtues.selfcontrol.value system.blood.value)}} {{localize "NOCTIS.ui.LimiteeAParLeSang" value=system.blood.value}}{{/if}} {{localize "NOCTIS.ui.Courage" value=system.virtues.courage.value}}{{#if hungry}} · <b class="warn-text">{{{localize "NOCTIS.ui.Assoiffe"}}}{{/if}}</p>
        <div class="btn-row">
          <button type="button" data-action="beastTest" data-kind="frenzy"><i class="fa-solid fa-face-angry"></i> {{localize "NOCTIS.ui.TestDeFrenesie"}}</button>
          <button type="button" data-action="beastTest" data-kind="panic"><i class="fa-solid fa-fire"></i> {{localize "NOCTIS.ui.TestDePanique"}}</button>
        </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Armes"}}</span></h2>
  <table class="weapon-table">
    <thead><tr><th></th><th>{{localize "NOCTIS.ui.Arme"}}</th><th>{{localize "NOCTIS.ui.Jet"}}</th><th>{{localize "NOCTIS.ui.Diff"}}</th><th>{{localize "NOCTIS.ui.Degats"}}</th><th>{{localize "NOCTIS.ui.Portee"}}</th><th>{{localize "NOCTIS.ui.Dissim"}}</th><th></th></tr></thead>
    <tbody>
      <tr class="unarmed">
        <td></td><td>{{localize "NOCTIS.ui.CoupDePoing"}}</td><td>{{localize "NOCTIS.ui.DexBagarre"}}</td><td>6</td><td>{{localize "NOCTIS.ui.ForC"}}</td><td>—</td><td>—</td>
        <td class="ctrl"><a class="attack-btn" data-action="rollUnarmed" data-tooltip="{{localize "NOCTIS.ui.AttaquerAMainsNues"}}"><i class="fa-solid fa-hand-fist"></i></a></td>
      </tr>
      {{#each weapons}}
        <tr class="draggable {{#unless sys.equipped}}unequipped{{/unless}}" data-item-id="{{id}}">
          <td><img class="item-img" src="{{img}}" alt=""></td>
          <td><a class="item-name" data-action="select" data-kind="item">{{name}}</a>{{#if sys.armorPiercing}} <span class="tag" data-tooltip="{{localize "NOCTIS.ui.PerforationDArmure"}}">{{localize "NOCTIS.ui.Pa" armorPiercing=sys.armorPiercing}}</span>{{/if}}</td>
          <td>{{attackPool}} <small>({{abilityLabel}})</small></td>
          <td>{{sys.difficulty}}</td>
          <td>{{damagePool}} <small>{{damageType}}</small></td>
          <td>{{#if sys.range}}{{sys.range}} m{{else}}—{{/if}}</td>
          <td>{{sys.conceal}}</td>
          <td class="ctrl">
            <a class="attack-btn" data-action="rollAttack" data-tooltip="{{localize "NOCTIS.ui.Attaquer"}}"><i class="fa-solid fa-khanda"></i></a>
            <a data-action="itemToggle" data-tooltip="{{localize "NOCTIS.ui.EquiperRanger"}}"><i class="fa-solid {{#if sys.equipped}}fa-hand-fist{{else}}fa-box-archive{{/if}}"></i></a>
            <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="list-footer"><span class="hint">{{localize "NOCTIS.ui.GlissezDesArmesDepuisLeCompendium"}}</span><a class="add-row" data-action="itemCreate" data-type="weapon"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Arme2"}}</a></div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.ArmuresEtBoucliers"}}</span></h2>
  <ul class="item-list">
    {{#each armors}}
      <li class="item-row draggable {{#unless system.equipped}}unequipped{{/unless}}" data-item-id="{{id}}">
        <img class="item-img" src="{{img}}" alt="">
        <a class="item-name" data-action="select" data-kind="item">{{name}}</a>
        <span class="item-cost">{{#if (noctisEq system.kind "shield")}}{{localize "NOCTIS.ui.ParadeDiff" parryDifficulty=system.parryDifficulty}}{{else}}{{localize "NOCTIS.ui.NiveauPenalite" rating=system.rating penalty=system.penalty}}{{/if}}</span>
        <span class="item-controls">
          <a data-action="itemToggle" data-tooltip="{{localize "NOCTIS.ui.PorterRetirer"}}"><i class="fa-solid {{#if system.equipped}}fa-shirt{{else}}fa-box-archive{{/if}}"></i></a>
          <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
        </span>
      </li>
    {{/each}}
  </ul>
  <div class="list-footer"><span></span><a class="add-row" data-action="itemCreate" data-type="armor"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Armure2"}}</a></div>
</section>
