<div class="tabs-wrap">
{{#unless creationDone}}<div class="creation-banner"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "NOCTIS.ui.PersonnageEnCreation"}} <a data-action="openCreator">{{localize "NOCTIS.ui.OuvrirLeCreateurDePersonnage"}}</a> {{localize "NOCTIS.ui.GuideOuLibreOuRemplissezLa"}}</div>{{/unless}}
<div class="tabs-row">
<nav class="noctis-tabs">
  {{#each tabs}}
    <a class="tab-link {{cssClass}}" data-action="switchTab" data-tab="{{id}}"><i class="{{icon}}"></i> <span>{{label}}</span></a>
  {{/each}}
</nav>
<nav class="noctis-tabs noctis-tabs-side">
  <a class="tab-link {{variantsTab.cssClass}}" data-action="switchTab" data-tab="variants" data-tooltip="{{localize "NOCTIS.ui.ReglesEnVigueurDansCetteChronique" length=variants.active.length}}"><i class="{{variantsTab.icon}}"></i> <span>{{variantsTab.label}}</span>{{#if variants.active.length}}<b class="tab-badge">{{variants.active.length}}</b>{{/if}}</a>
</nav>
</div>
</div>
