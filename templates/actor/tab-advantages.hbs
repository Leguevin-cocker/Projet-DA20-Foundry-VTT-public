<section class="tab tab-advantages {{tab.cssClass}}" data-tab="advantages">
  {{#if clan}}
    <div class="clan-banner" data-item-id="{{clan.id}}">
      {{#if clanEmblem}}<img src="{{clanEmblem}}" alt="">{{/if}}
      <div>
        <h3><a data-action="select" data-kind="item">{{clan.name}}</a>{{#if clan.system.nickname}} <em>— {{clan.system.nickname}}</em>{{/if}}</h3>
        <p class="weakness">{{{localize "NOCTIS.ui.Faiblesse" clanWeakness=clanWeakness}}}</p>
      </div>
    </div>
  {{else if isVampire}}
    <p class="drop-hint"><i class="fa-solid fa-hand-pointer"></i> {{{localize "NOCTIS.ui.GlissezUneLigneeDepuisLOnglet"}}}</p>
  {{/if}}

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Historiques"}}</span></h2>
  <div class="columns two backgrounds">
    {{#each backgrounds}}
      <div class="trait-row bg-row">
        <a class="trait-label" data-action="select" data-kind="background" data-key="{{key}}" data-tooltip="{{localize "NOCTIS.ui.ClicDetails"}}">{{label}}</a>
        <input class="spec" type="text" name="{{notesPath}}" value="{{notes}}" placeholder="{{localize "NOCTIS.ui.Precisions"}}">
        {{noctisDots value=value max=max path=path}}
      </div>
    {{/each}}
  </div>

  <div class="columns two">
    <div>
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Atouts"}}</span></h2>
      <ul class="item-list">
        {{#each merits}}{{> "systems/noctis/templates/actor/parts/item-row.hbs" item=this cost=true}}{{/each}}
      </ul>
      <div class="list-footer"><span>{{localize "NOCTIS.ui.TotalPtS" meritTotal=meritTotal}}</span><a class="add-row" data-action="itemCreate" data-type="merit"><i class="fa-solid fa-plus"></i></a></div>
    </div>
    <div>
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Handicaps"}}</span></h2>
      <ul class="item-list">
        {{#each flaws}}{{> "systems/noctis/templates/actor/parts/item-row.hbs" item=this cost=true}}{{/each}}
      </ul>
      <div class="list-footer"><span>{{localize "NOCTIS.ui.TotalPtS2" flawTotal=flawTotal}}{{#if (noctisGt flawTotal 7)}} <em class="warn">{{{localize "NOCTIS.ui.7MaximumALaCreation"}}}{{/if}}</span><a class="add-row" data-action="itemCreate" data-type="flaw"><i class="fa-solid fa-plus"></i></a></div>
    </div>
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Derangements"}}</span></h2>
  <ul class="item-list">
    {{#each derangements}}{{> "systems/noctis/templates/actor/parts/item-row.hbs" item=this}}{{/each}}
  </ul>
  <div class="list-footer"><span></span><a class="add-row" data-action="itemCreate" data-type="derangement"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Derangement"}}</a></div>

  {{#unless isVampire}}
    <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.VraieFoi"}}</span></h2>
    <div class="trait-row">{{noctisDots value=system.faith max=10 path="system.faith"}}</div>
  {{/unless}}
</section>
