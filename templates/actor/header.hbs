<header class="noctis-header">
  <div class="portrait-wrap">
    <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="pickImage" data-tooltip="{{localize "NOCTIS.ui.ChangerLePortrait"}}">
    {{#if clanEmblem}}<img class="clan-emblem" src="{{clanEmblem}}" alt="{{clan.name}}" data-tooltip="{{clan.name}}{{#if clan.system.nickname}} — {{clan.system.nickname}}{{/if}}">{{/if}}
  </div>

  <div class="identity">
    <div class="title-row">
      <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize "NOCTIS.ui.NomDuPersonnage"}}">
      {{#if inCombat}}<span class="combat-pill {{#unless system.combat.actions}}empty{{/unless}}" data-action="switchTab" data-tab="combat" data-tooltip="{{localize "NOCTIS.ui.ActionsRestantesCeTourAttaquesPossibles"}}"><i class="fa-solid fa-khanda"></i> {{{localize "NOCTIS.ui.Att" actions=system.combat.actions actionsMax=system.combat.actionsMax attacksLeft=system.combat.attacksLeft}}}</span>{{/if}}
      <div class="header-controls">
        {{#if isGM}}
          <button type="button" class="icon-btn pc-flag {{#if isPC}}on{{/if}}" data-action="togglePC" data-tooltip="{{#if isPC}}{{localize "NOCTIS.ui.PersonnageJoueurCliquezPourRetirer"}}{{else}}{{localize "NOCTIS.ui.MarquerCommePersonnageJoueur"}}{{/if}}">{{localize "NOCTIS.ui.Pj"}}</button>
        {{else if isPC}}
          <span class="icon-btn pc-flag on static" data-tooltip="{{localize "NOCTIS.ui.PersonnageJoueur"}}">{{localize "NOCTIS.ui.Pj"}}</span>
        {{/if}}
        {{#if creationDone}}
          <button type="button" class="icon-btn lock {{#if locked}}is-locked{{/if}}" data-action="toggleLock" data-tooltip="{{#if locked}}{{localize "NOCTIS.ui.FicheVerrouilleeChaquePointCouteDe"}}{{else}}{{localize "NOCTIS.ui.EditionLibreLesPointsNeCoutent"}}{{/if}}">
            <i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
          </button>
        {{/if}}
        <button type="button" class="icon-btn" data-action="openCreator" data-tooltip="{{localize "NOCTIS.ui.CreateurDePersonnage"}}"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
        <button type="button" class="icon-btn {{#if creationDone}}done{{/if}}" data-action="finishCreation" data-tooltip="{{#if creationDone}}{{localize "NOCTIS.ui.RepasserEnModeCreation"}}{{else}}{{localize "NOCTIS.ui.TerminerLaCreationLesProgressionsSe"}}{{/if}}"><i class="fa-solid {{#if creationDone}}fa-flag-checkered{{else}}fa-hourglass-half{{/if}}"></i></button>
      </div>
    </div>

    <div class="identity-grid">
      <label><span>{{localize "NOCTIS.ui.Joueur"}}</span><input type="text" name="system.identity.player" value="{{system.identity.player}}"></label>
      <label><span>{{localize "NOCTIS.ui.Nature"}}</span><input type="text" name="system.identity.nature" value="{{system.identity.nature}}" list="noctis-archetypes-{{actor.id}}"></label>
      {{#if isVampire}}
        <label class="clan-field" data-tooltip="{{localize "NOCTIS.ui.GlissezUnClanDepuisLeCompendium"}}"><span>{{localize "NOCTIS.ui.Clan"}}</span><input type="text" name="system.identity.clan" value="{{system.identity.clan}}" placeholder="{{localize "NOCTIS.ui.GlissezUnClan"}}"></label>
      {{else if isGhoul}}
        <label><span>{{localize "NOCTIS.ui.Domitor"}}</span><input type="text" name="system.identity.domitor" value="{{system.identity.domitor}}"></label>
      {{else if isNpc}}
        <label><span>{{localize "NOCTIS.ui.Type"}}</span><select name="system.npcKind">{{noctisOptions npcKinds system.npcKind}}</select></label>
      {{else}}
        <label><span>{{localize "NOCTIS.ui.Allegeance"}}</span><input type="text" name="system.identity.domitor" value="{{system.identity.domitor}}"></label>
      {{/if}}
      <label><span>{{localize "NOCTIS.ui.Chronique"}}</span><input type="text" name="system.identity.chronicle" value="{{system.identity.chronicle}}"></label>
      <label><span>{{localize "NOCTIS.ui.Attitude"}}</span><input type="text" name="system.identity.demeanor" value="{{system.identity.demeanor}}" list="noctis-archetypes-{{actor.id}}"></label>
      {{#if isVampire}}
        <label class="generation" data-tooltip="{{localize "NOCTIS.ui.GenerationDeBase12MoinsL"}}"><span>{{localize "NOCTIS.ui.Generation"}}</span>
          <span class="gen-value">{{system.generationLabel}}</span>
          {{#unless locked}}<select name="system.generationBase" class="gen-base" data-tooltip="{{localize "NOCTIS.ui.GenerationSansLHistorique"}}">{{#each generationOptions}}<option value="{{this}}" {{#if (noctisEq this ../system.generationBase)}}selected{{/if}}>{{this}}e</option>{{/each}}</select>{{/unless}}
        </label>
      {{else}}
        <label><span>{{localize "NOCTIS.ui.Age"}}</span><input type="text" name="system.identity.age" value="{{system.identity.age}}"></label>
      {{/if}}
      <label><span>{{localize "NOCTIS.ui.Concept"}}</span><input type="text" name="system.identity.concept" value="{{system.identity.concept}}"></label>
      {{#if isVampire}}
        <label><span>{{localize "NOCTIS.ui.Sire"}}</span><input type="text" name="system.identity.sire" value="{{system.identity.sire}}"></label>
      {{else}}
        <label><span>{{localize "NOCTIS.ui.Refuge"}}</span><input type="text" name="system.identity.haven" value="{{system.identity.haven}}"></label>
      {{/if}}
      <div class="xp-badge" data-action="switchTab" data-tab="experience" data-tooltip="{{localize "NOCTIS.ui.ExperienceDisponibleGagneeAuTotal"}}">
        <span class="xp-label">{{localize "NOCTIS.ui.Experience"}}</span>
        <span class="xp-available">{{system.experience.available}}</span>
        <span class="xp-total">/ {{system.experience.total}}</span>
      </div>
    </div>
    <datalist id="noctis-archetypes-{{actor.id}}">{{#each archetypes}}<option value="{{this}}"></option>{{/each}}</datalist>
  </div>

  <div class="resources">
    {{#if usesBlood}}
    <div class="resource blood" data-tooltip="{{localize "NOCTIS.ui.ReserveDeSangPointSPar" value=system.blood.value max=system.blood.max perTurn=system.blood.perTurn}}">
      <div class="res-title"><i class="fa-solid fa-droplet"></i> {{{localize "NOCTIS.ui.SangTour" value=system.blood.value max=system.blood.max perTurn=system.blood.perTurn}}}</div>
      <div class="squares blood-squares" data-path="system.blood.value" data-value="{{system.blood.value}}">
        {{#each bloodSquares}}<span class="sq {{#if filled}}filled{{/if}}" data-action="setSquares" data-n="{{n}}"></span>{{/each}}
      </div>
    </div>
    {{/if}}

    <div class="resource willpower">
      <div class="res-title"><i class="fa-solid fa-shield-heart"></i> {{localize "NOCTIS.ui.Volonte"}}
        <span class="roll-link" data-action="rollVirtue" data-kind="willpower" data-tooltip="{{localize "NOCTIS.ui.JetDeVolonte"}}"><i class="fa-solid fa-dice-d10"></i></span>
      </div>
      {{noctisDots value=system.willpower.permanent max=10 path="system.willpower.permanent"}}
      <div class="squares wp-squares" data-path="system.willpower.temporary" data-value="{{system.willpower.temporary}}">
        {{#each wpSquares}}<span class="sq {{#if filled}}filled{{/if}} {{#unless available}}unavailable{{/unless}}" data-action="setSquares" data-n="{{n}}"></span>{{/each}}
      </div>
    </div>

    <div class="resource health {{#if system.health.incapacitated}}critical{{/if}}">
      <div class="res-title"><i class="fa-solid fa-heart-pulse"></i> {{{localize "NOCTIS.ui.Sante" status=system.health.status}}}
        {{#if system.health.penalty}}<span class="penalty">{{localize "NOCTIS.ui.Des" penalty=system.health.penalty}}</span>{{/if}}
        {{#if system.health.torpor}}<span class="state torpor">{{localize "NOCTIS.ui.Torpeur"}}</span>{{/if}}
        {{#if system.health.finalDeath}}<span class="state death">{{localize "NOCTIS.ui.MortUltime"}}</span>{{/if}}
      </div>
      <div class="health-track" data-tooltip="{{localize "NOCTIS.ui.Clic1ContondantMajClicLetal"}}">
        {{#each system.health.track}}
          <span class="hbox {{state}}" data-action="healthClick" data-health-index="{{index}}" data-tooltip="{{label}}{{#if penalty}} ({{penalty}}){{/if}}"></span>
        {{/each}}
      </div>
    </div>

    <div class="resource road">
      <div class="res-title"><i class="fa-solid fa-route"></i> <span class="road-name">{{#if system.road.name}}{{system.road.name}}{{else}}{{localize "NOCTIS.ui.Voie"}}{{/if}}</span>
        <span class="roll-link" data-action="rollVirtue" data-kind="road" data-tooltip="{{localize "NOCTIS.ui.JetDeVoie"}}"><i class="fa-solid fa-dice-d10"></i></span>
      </div>
      {{noctisDots value=system.road.value max=10 path="system.road.value"}}
      {{#if system.road.aura}}<div class="aura" data-tooltip="{{localize "NOCTIS.ui.Aura"}}">{{system.road.aura}}</div>{{/if}}
    </div>
  </div>
</header>
