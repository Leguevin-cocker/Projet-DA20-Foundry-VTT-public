<section class="tab tab-domain {{tab.cssClass}}" data-tab="domain">
  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Domaine"}}</span></h2>
  <div class="domain-head">
    <label class="dfield wide"><span>{{localize "NOCTIS.ui.NomDuDomaine"}}</span><input type="text" name="system.domain.name" value="{{system.domain.name}}" placeholder="{{localize "NOCTIS.ui.ExLaParoisseSaintGall"}}"></label>
    <label class="dfield"><span>{{localize "NOCTIS.ui.Lieu"}}</span><input type="text" name="system.domain.location" value="{{system.domain.location}}" placeholder="{{localize "NOCTIS.ui.CiteQuartier"}}"></label>
    <label class="dfield"><span>{{localize "NOCTIS.ui.ReconnuPar"}}</span><input type="text" name="system.domain.grantedBy" value="{{system.domain.grantedBy}}" placeholder="{{localize "NOCTIS.ui.PrinceSeigneurVampire"}}"></label>
  </div>

  <div class="domain-grid">
    <div class="domain-card">
      <h3>{{localize "NOCTIS.ui.PointsDeDomaine"}}</h3>
      <p class="domain-total">{{{localize "NOCTIS.ui.Historique" background=dom.background}}}{{#if system.domain.pooled}} {{{localize "NOCTIS.ui.MisEnCommun" poolTotal=system.domain.poolTotal}}}{{/if}} {{{localize "NOCTIS.ui.PointSARepartir" total=dom.total}}}</p>
      <div class="split">
        <label><span>{{localize "NOCTIS.ui.Taille"}}</span><input type="number" min="0" max="10" name="system.domain.size" value="{{system.domain.size}}"></label>
        <label><span>{{localize "NOCTIS.ui.Securite"}}</span><input type="number" min="0" max="10" name="system.domain.security" value="{{system.domain.security}}"></label>
      </div>
      {{#if dom.mismatch}}<p class="warn">{{localize "NOCTIS.ui.TailleSecuritePourPointSDisponibles" spent=dom.spent total=dom.total}}</p>{{/if}}
      <ul class="domain-effects">
        <li>{{{localize "NOCTIS.ui.TailleALaDifficulteDeChasse" size=system.domain.size}}}</li>
        <li>{{{localize "NOCTIS.ui.SecuriteALaDifficultePourS" security=system.domain.security}}}</li>
      </ul>
      <label class="pool"><input type="checkbox" name="system.domain.pooled" {{#if system.domain.pooled}}checked{{/if}}> {{localize "NOCTIS.ui.DomaineMisEnCommunAvecLa"}}</label>
      {{#if system.domain.pooled}}
        <div class="split">
          <label><span>{{localize "NOCTIS.ui.TotalCommun"}}</span><input type="number" min="0" max="20" name="system.domain.poolTotal" value="{{system.domain.poolTotal}}"></label>
          <label><span>{{localize "NOCTIS.ui.Ancrage"}}</span><input type="text" name="system.domain.anchor" value="{{system.domain.anchor}}" placeholder="{{localize "NOCTIS.ui.HistoriqueDAncrage"}}"></label>
        </div>
        <p class="hint">{{localize "NOCTIS.ui.MiseEnCommunAucunHistoriqueCommun"}}</p>
      {{/if}}
    </div>

    <div class="domain-card">
      <h3>{{localize "NOCTIS.ui.Etendue"}}</h3>
      <ol class="domain-levels">
        {{#each dom.levels}}<li class="{{#if current}}current{{/if}}"><b>{{dots}}</b> {{text}}</li>{{/each}}
      </ol>
    </div>

    <div class="domain-card hunt">
      <h3>{{localize "NOCTIS.ui.Chasser"}}</h3>
      <label class="dfield"><span>{{localize "NOCTIS.ui.Zone"}}</span><select name="system.domain.zone">{{noctisOptions dom.zoneChoices system.domain.zone}}</select></label>
      <label class="dfield"><span>{{localize "NOCTIS.ui.Technique"}}</span><select class="hunt-method">{{noctisOptions dom.methodChoices "seduce"}}</select></label>
      <p class="hunt-calc">{{{localize "NOCTIS.ui.DifficulteDomaineRenommeeMinimum3" huntDiff=dom.huntDiff zoneDiff=dom.zoneDiff size=system.domain.size fame=dom.fame}}}{{#if dom.herd}} {{{localize "NOCTIS.ui.TroupeauDeS" herd=dom.herd}}}{{/if}}</p>
      <button type="button" data-action="hunt"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.ChasserUnJetParHeure"}}</button>
      <p class="hint">{{localize "NOCTIS.ui.UneReussiteLeVampireAttrapeSa"}}</p>
    </div>
  </div>

  <div class="domain-notes">
    <label class="dfield"><span>{{localize "NOCTIS.ui.Refuge"}}</span><textarea name="system.domain.haven" rows="2" placeholder="{{localize "NOCTIS.ui.OuDormezVousLeJourQui"}}">{{system.domain.haven}}</textarea></label>
    <label class="dfield"><span>{{localize "NOCTIS.ui.HabitantsEtRessources"}}</span><textarea name="system.domain.residents" rows="2" placeholder="{{localize "NOCTIS.ui.QuiYVitCeQuOn"}}">{{system.domain.residents}}</textarea></label>
    <label class="dfield"><span>{{localize "NOCTIS.ui.Defenses"}}</span><textarea name="system.domain.defenses" rows="2" placeholder="{{localize "NOCTIS.ui.GardesPortesAccesRestreints"}}">{{system.domain.defenses}}</textarea></label>
    <label class="dfield"><span>{{localize "NOCTIS.ui.MenacesEtRivaux"}}</span><textarea name="system.domain.threats" rows="2" placeholder="{{localize "NOCTIS.ui.QuiConvoiteCeDomaine"}}">{{system.domain.threats}}</textarea></label>
    <label class="dfield wide"><span>{{localize "NOCTIS.ui.Notes"}}</span><textarea name="system.domain.notes" rows="3">{{system.domain.notes}}</textarea></label>
  </div>
</section>
