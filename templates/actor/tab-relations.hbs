<section class="tab tab-relations {{tab.cssClass}}" data-tab="relations">
  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.AlliesContactsEtAutresLiens"}}</span></h2>
  <div class="rel-quota">
    {{#each relQuota}}
      <span class="quota {{#if over}}over{{/if}} {{#if full}}full{{/if}}" data-tooltip="{{tip}}"><i class="{{icon}}"></i> {{label}} <b>{{count}} / {{allowed}}</b></span>
    {{/each}}
  </div>
  <p class="hint">{{localize "NOCTIS.ui.GlissezIciUnActeurPnjAutre"}}</p>

  <div class="rel-list">
    {{#each relations}}
      <article class="rel-card attitude-{{attitude}}" data-rel-index="{{index}}">
        <a class="rel-img-wrap" {{#if actorUuid}}data-action="relOpen" data-tooltip="{{localize "NOCTIS.ui.OuvrirLaFicheLiee"}}"{{/if}}><img class="rel-img" src="{{img}}" alt=""></a>
        <div class="rel-main">
          <div class="rel-line">
            <input class="rel-name" type="text" data-array="relations" data-index="{{index}}" data-field="name" value="{{name}}" placeholder="{{localize "NOCTIS.ui.Nom"}}">
            <select data-array="relations" data-index="{{index}}" data-field="kind" data-tooltip="{{localize "NOCTIS.ui.TypeDeLien"}}">{{noctisOptions ../relKindChoices kind}}</select>
            <select data-array="relations" data-index="{{index}}" data-field="attitude" data-tooltip="{{localize "NOCTIS.ui.AttitudeEnversVous"}}">{{noctisOptions ../attitudeChoices attitude}}</select>
            <select class="rel-influence" data-array="relations" data-index="{{index}}" data-field="influence" data-tooltip="{{localize "NOCTIS.ui.InfluencePuissance0A5"}}">{{noctisOptions ../influenceChoices influence}}</select>
          </div>
          <input class="rel-place" type="text" data-array="relations" data-index="{{index}}" data-field="place" value="{{place}}" placeholder="{{localize "NOCTIS.ui.LieuMilieuDomaineDExpertise"}}">
          <div class="rel-bond {{#if bondTo}}on{{/if}} {{#if bondFrom}}on{{/if}}">
            <i class="fa-solid fa-link" data-tooltip="{{localize "NOCTIS.ui.LienDeSang1reGorgeeAttachement"}}"></i>
            <label>{{localize "NOCTIS.ui.JeSuisSonSoumis"}} <select data-array="relations" data-index="{{index}}" data-field="bondTo">{{noctisOptions ../bondChoices bondTo}}</select></label>
            <label>{{localize "NOCTIS.ui.IlEstMonSoumis"}} <select data-array="relations" data-index="{{index}}" data-field="bondFrom">{{noctisOptions ../bondChoices bondFrom}}</select></label>
          </div>
          <textarea data-array="relations" data-index="{{index}}" data-field="notes" rows="2" placeholder="{{localize "NOCTIS.ui.CeQuIlVousApporteCe"}}">{{notes}}</textarea>
        </div>
        <span class="rel-controls"><a data-action="relDelete" data-tooltip="{{localize "NOCTIS.ui.Supprimer"}}"><i class="fa-solid fa-trash"></i></a></span>
      </article>
    {{else}}
      <p class="empty">{{localize "NOCTIS.ui.AucunLienPourLInstant"}}</p>
    {{/each}}
  </div>
  <div class="add-buttons">
    {{#each relKindList}}<a class="add-row" data-action="relAdd" data-kind="{{key}}"><i class="fa-solid fa-plus"></i> {{label}}</a>{{/each}}
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.CeQueJePenseDesAutres"}}</span></h2>
  <div class="op-list">
    {{#each opinions}}
      <div class="op-row trust-{{trustClass}}">
        <img class="rel-img" src="{{img}}" alt="">
        <div class="op-main">
          <div class="rel-line">
            <b class="op-name">{{name}}</b><span class="op-sub">{{subtitle}}</span>
            <select data-array="opinions" data-key="{{actorId}}" data-field="trust">{{noctisOptions ../trustChoices trust}}</select>
          </div>
          <textarea data-array="opinions" data-key="{{actorId}}" data-field="text" rows="2" placeholder="{{localize "NOCTIS.ui.VotreAvisVosDettesVosSoupcons"}}">{{text}}</textarea>
          <div class="rel-bond {{#if bondTo}}on{{/if}} {{#if bondFrom}}on{{/if}}">
            <i class="fa-solid fa-link" data-tooltip="{{localize "NOCTIS.ui.LienDeSangEntreVosDeux"}}"></i>
            <label>{{localize "NOCTIS.ui.JeSuisSonSoumis"}} <select data-array="opinions" data-key="{{actorId}}" data-field="bondTo">{{noctisOptions ../bondChoices bondTo}}</select></label>
            <label>{{localize "NOCTIS.ui.IlEstMonSoumis"}} <select data-array="opinions" data-key="{{actorId}}" data-field="bondFrom">{{noctisOptions ../bondChoices bondFrom}}</select></label>
          </div>
        </div>
      </div>
    {{else}}
      <p class="empty">{{localize "NOCTIS.ui.AucunAutrePersonnageJoueurDansCe"}}</p>
    {{/each}}
  </div>
  <p class="hint">{{localize "NOCTIS.ui.CesNotesSeTrouventSurVotre"}}</p>
</section>
