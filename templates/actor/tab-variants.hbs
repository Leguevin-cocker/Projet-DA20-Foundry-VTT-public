<section class="tab tab-variants {{tab.cssClass}}" data-tab="variants">
  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.VariantesDeRegles"}}</span></h2>
  <p class="variants-intro">{{localize "NOCTIS.ui.CesReglesSontChoisiesParLe"}}{{#if isGM}} <a data-action="openRuleSettings"><i class="fa-solid fa-gear"></i> {{localize "NOCTIS.ui.ModifierDansLesParametresDuJeu"}}</a>{{/if}}</p>

  <h3 class="variants-head active"><i class="fa-solid fa-circle-check"></i> {{localize "NOCTIS.ui.VariantesActives" length=variants.active.length}}</h3>
  {{#each variants.active}}
    <article class="variant-card active">
      <i class="v-icon {{icon}}"></i>
      <div class="v-body">
        <header><b>{{title}}</b><span class="v-group">{{group}}</span></header>
        <p class="v-choice">{{choice}}</p>
        <p class="v-text">{{text}}</p>
        <p class="v-book"><i class="fa-solid fa-book"></i> {{localize "NOCTIS.ui.AuLieuDeLaRegleDe" book=book}}</p>
      </div>
    </article>
  {{else}}
    <p class="empty">{{localize "NOCTIS.ui.AucuneVarianteLaChroniqueSuitLes"}}</p>
  {{/each}}

  <details class="variants-book">
    <summary><i class="fa-solid fa-book"></i> {{localize "NOCTIS.ui.ReglesDeBaseEnVigueur" length=variants.book.length}}</summary>
    {{#each variants.book}}
      <article class="variant-card book">
        <i class="v-icon {{icon}}"></i>
        <div class="v-body">
          <header><b>{{title}}</b><span class="v-group">{{group}}</span></header>
          <p class="v-text">{{text}}</p>
        </div>
      </article>
    {{/each}}
  </details>
</section>
