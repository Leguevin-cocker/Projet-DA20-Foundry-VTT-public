<section class="tab tab-disciplines {{tab.cssClass}}" data-tab="disciplines">
  <h2 class="noctis-section"><span>Disciplines</span></h2>
  {{#unless hasDisciplines}}
    <p class="drop-hint"><i class="fa-solid fa-hand-pointer"></i> Glissez une discipline ou une voie depuis l'onglet Objets ou un compendium. Le clan ajoute automatiquement ses disciplines.</p>
  {{/unless}}
  <div class="discipline-list">
    {{#each disciplines}}
      <article class="discipline-card draggable {{#unless expanded}}collapsed{{/unless}} {{#if isClan}}in-clan{{/if}}" data-item-id="{{id}}">
        <header>
          <a class="toggle" data-action="togglePower"><i class="fa-solid fa-chevron-down"></i></a>
          <img src="{{img}}" alt="">
          <div class="disc-title">
            <a class="disc-name" data-action="select" data-kind="discipline">{{name}}</a>
            <span class="disc-tags">
              {{#if isClan}}<span class="tag clan" data-tooltip="Discipline de clan : progression à niveau × 5 XP">Clan</span>{{/if}}
              {{#if isPath}}<span class="tag path">Voie de {{parentLabel}}</span>{{/if}}
            </span>
          </div>
          {{noctisDots value=value max=max path=path}}
          <span class="mini-controls">
            <a data-action="rollTrait" data-ref="item.{{id}}" data-tooltip="Jet libre avec cette discipline"><i class="fa-solid fa-dice-d10"></i></a>
            <a data-action="itemChat" data-tooltip="Montrer dans le chat"><i class="fa-solid fa-comment"></i></a>
            <a data-action="itemDelete" data-tooltip="Supprimer"><i class="fa-solid fa-trash"></i></a>
          </span>
        </header>
        <ol class="powers">
          {{#each powers}}
            <li class="power {{#if unlocked}}unlocked{{else}}locked{{/if}} {{#if advanced}}advanced{{/if}}">
              <span class="power-level">{{dotsLabel}}</span>
              <a class="power-name" data-action="select" data-kind="power" data-idx="{{idx}}" {{#if unlocked}}data-roll="power"{{/if}} data-tooltip="Clic : détails{{#if unlocked}} · double-clic : utiliser{{/if}}">{{name}}</a>
              <span class="power-pool">{{#if poolLabel}}{{poolLabel}}{{/if}}{{#if difficulty}} · diff. {{difficulty}}{{/if}}{{#if cost}} · <i class="fa-solid fa-droplet"></i> {{cost}}{{/if}}</span>
              {{#if page}}<span class="power-page">p. {{page}}</span>{{/if}}
              {{#if unlocked}}<a class="power-roll" data-action="rollPower" data-idx="{{idx}}" data-tooltip="Utiliser ce pouvoir"><i class="fa-solid fa-dice-d10"></i></a>{{/if}}
            </li>
          {{/each}}
        </ol>
      </article>
    {{/each}}
  </div>

  {{#if rituals.length}}
    <h2 class="noctis-section"><span>Rituels</span></h2>
    <ul class="item-list">
      {{#each rituals}}
        <li class="item-row draggable" data-item-id="{{id}}">
          <img class="item-img" src="{{img}}" alt="">
          <a class="item-name" data-action="select" data-kind="item">{{name}}</a>
          <span class="item-cost">Niveau {{system.level}}</span>
          <span class="item-controls"><a data-action="itemChat"><i class="fa-solid fa-comment"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span>
        </li>
      {{/each}}
    </ul>
  {{/if}}
  <div class="add-buttons">
    <a class="add-row" data-action="itemCreate" data-type="discipline"><i class="fa-solid fa-plus"></i> discipline personnalisée</a>
    <a class="add-row" data-action="itemCreate" data-type="ritual"><i class="fa-solid fa-plus"></i> rituel</a>
  </div>
</section>
