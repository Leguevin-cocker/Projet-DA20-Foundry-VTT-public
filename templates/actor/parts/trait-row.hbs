<div class="trait-row {{#if trait.mod}}modded{{/if}}">
  <a class="trait-label" data-action="select" data-kind="trait" data-ref="{{trait.ref}}" data-roll="trait" data-tooltip="{{localize "NOCTIS.ui.ClicDetailsDoubleClicLancer"}}">{{trait.label}}</a>
  {{#if showSpec}}<input class="spec" type="text" name="{{trait.specPath}}" value="{{trait.spec}}" placeholder="{{localize "NOCTIS.ui.Specialite"}}" data-tooltip="{{localize "NOCTIS.ui.SpecialiteAPartirDe4Points"}}">{{/if}}
  {{noctisDots value=trait.value max=trait.max path=trait.path mod=trait.mod locked=trait.locked}}
  {{#if trait.boost}}<span class="boost" data-tooltip="{{localize "NOCTIS.ui.AmplifieParLeSang"}}">+{{trait.boost}}</span>{{/if}}
</div>
