<section class="tab tab-biography {{tab.cssClass}}" data-tab="biography">
  <div class="columns two bio-fields">
    {{#if isVampire}}
    <label><span>{{localize "NOCTIS.ui.AgeReel"}}</span><input type="text" name="system.identity.age" value="{{system.identity.age}}"></label>
    <label><span>{{localize "NOCTIS.ui.Refuge"}}</span><input type="text" name="system.identity.haven" value="{{system.identity.haven}}"></label>
    {{/if}}
    <label><span>{{localize "NOCTIS.ui.AgeApparent"}}</span><input type="text" name="system.identity.apparentAge" value="{{system.identity.apparentAge}}"></label>
    <label><span>{{localize "NOCTIS.ui.TerrainDeChasse"}}</span><input type="text" name="system.possessions.feeding" value="{{system.possessions.feeding}}"></label>
  </div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Histoire"}}</span></h2>
  <prose-mirror name="system.biography" button="true" toggled="true" {{#if editable}}editable{{/if}} value="{{system.biography}}">{{{enrichedBio}}}</prose-mirror>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Possessions"}}</span></h2>
  <div class="columns two">
    <label class="area"><span>{{localize "NOCTIS.ui.EquipementPorte"}}</span><textarea name="system.possessions.carried" rows="3">{{system.possessions.carried}}</textarea></label>
    <label class="area"><span>{{localize "NOCTIS.ui.BiensPossedes"}}</span><textarea name="system.possessions.owned" rows="3">{{system.possessions.owned}}</textarea></label>
    <label class="area"><span>{{localize "NOCTIS.ui.MonturesEtTransport"}}</span><textarea name="system.possessions.transport" rows="2">{{system.possessions.transport}}</textarea></label>
  </div>
  <ul class="item-list">
    {{#each gear}}
      <li class="item-row draggable" data-item-id="{{id}}">
        <img class="item-img" src="{{img}}" alt=""><a class="item-name" data-action="select" data-kind="item">{{name}}</a>
        <span class="item-cost">×{{system.quantity}}</span>
        <span class="item-controls"><a data-action="itemChat"><i class="fa-solid fa-comment"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span>
      </li>
    {{/each}}
  </ul>
  <div class="list-footer"><span></span><a class="add-row" data-action="itemCreate" data-type="gear"><i class="fa-solid fa-plus"></i> {{localize "NOCTIS.ui.Objet"}}</a></div>

  <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Notes"}}</span></h2>
  <prose-mirror name="system.notes" button="true" toggled="true" {{#if editable}}editable{{/if}} value="{{system.notes}}">{{{enrichedNotes}}}</prose-mirror>
</section>
