<div class="creator">
  <aside class="creator-steps">
    <i class="creator-ankh fa-solid fa-droplet"></i>
    {{#each steps}}
      <a class="cstep {{#if active}}active{{/if}} {{#if done}}done{{/if}} {{#if error}}error{{/if}}" data-action="goto" data-step="{{id}}">
        <span class="num">{{id}}</span><i class="{{icon}}"></i> <span>{{label}}</span>
      </a>
    {{/each}}
    {{#if modeChosen}}
      <div class="mode-badge {{#if free}}free{{/if}}">{{#if free}}{{localize "NOCTIS.ui.ModeLibre"}}{{else}}{{localize "NOCTIS.ui.ModeGuide"}}{{/if}}</div>
      <div class="bonus-meter"><span class="n">{{bonusLeft}}</span><span class="l">{{{localize "NOCTIS.ui.PointsDeBonusRestants" bonusTotal=bonusTotal}}}</span></div>
      <a class="reset" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{localize "NOCTIS.ui.Recommencer"}}</a>
    {{/if}}
  </aside>

  <section class="creator-main">
    {{#if noPacks}}
      <p class="alert">{{localize "NOCTIS.ui.AucuneLigneeTrouveeCreezVosLignees"}}</p>
    {{/if}}

    {{!-- ===================== 0. MODE ===================== --}}
    {{#if (noctisEq step 0)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.NaissanceDUnVampire"}}</span></h2>
      <p class="lead">{{localize "NOCTIS.ui.LaCreationSeFaitEnCinq"}}</p>
      <div class="mode-cards">
        <a class="mode-card" data-action="setMode" data-mode="guided">
          <i class="fa-solid fa-book-skull"></i>
          <h3>{{localize "NOCTIS.ui.ModeGuide"}}</h3>
          <p>{{localize "NOCTIS.ui.PasAPasChaqueChoixEst"}}</p>
        </a>
        <a class="mode-card" data-action="setMode" data-mode="free">
          <i class="fa-solid fa-feather-pointed"></i>
          <h3>{{localize "NOCTIS.ui.ModeLibre"}}</h3>
          <p>{{localize "NOCTIS.ui.PourLeConteurOuUnJoueur"}}</p>
        </a>
      </div>
    {{/if}}

    {{!-- ===================== 1. CONCEPT ===================== --}}
    {{#if (noctisEq step 1)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeILeConcept"}}</span></h2>
      <p class="lead">{{localize "NOCTIS.ui.QuiEtaitVotrePersonnageDeSon"}}</p>
      <div class="cgrid two">
        <label><span>{{localize "NOCTIS.ui.Nom"}}</span><input type="text" name="st.name" value="{{st.name}}"></label>
        <label><span>{{localize "NOCTIS.ui.Joueur"}}</span><input type="text" name="st.player" value="{{st.player}}"></label>
        <label class="wide"><span>{{localize "NOCTIS.ui.Concept"}}</span><input type="text" name="st.concept" value="{{st.concept}}" list="noctis-concepts"></label>
        <datalist id="noctis-concepts">{{#each concepts}}<option value="{{this}}"></option>{{/each}}</datalist>
        <label><span>{{localize "NOCTIS.ui.Sire"}}</span><input type="text" name="st.sire" value="{{st.sire}}"></label>
      </div>

      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.Clan"}}</h3>
      <div class="clan-pick">
        <select name="st.clanId">
          <option value="">{{localize "NOCTIS.ui.ChoisirUnClanOuUneLignee"}}</option>
          <optgroup label="{{localize "NOCTIS.ui.OptLineages"}}">{{#each clans}}{{#unless bloodline}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/unless}}{{/each}}</optgroup>
          <optgroup label="{{localize "NOCTIS.ui.OptBloodlines"}}">{{#each clans}}{{#if bloodline}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/if}}{{/each}}</optgroup>
        </select>
        {{#if clan}}
          <div class="clan-card">
            <img src="{{clan.system.emblem}}" alt="">
            <div>
              <h4>{{clan.name}} <em>{{clan.system.nickname}}</em></h4>
              <p>{{{localize "NOCTIS.ui.DisciplinesDeClan" clanDiscLabels=clanDiscLabels}}}{{#if clan.system.disciplineNote}} <em>({{clan.system.disciplineNote}})</em>{{/if}}</p>
              <p>{{{localize "NOCTIS.ui.Faiblesse2" weakness=clan.system.weakness}}}</p>
            </div>
          </div>
        {{/if}}
      </div>

      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.NatureEtAttitude"}}</h3>
      <p class="hint">{{{localize "NOCTIS.ui.LaNatureEstLaPersonnaliteProfonde"}}}</p>
      <div class="cgrid two">
        <label><span>{{localize "NOCTIS.ui.Nature"}}</span><select name="st.nature"><option value="">—</option>{{#each archetypes}}<option value="{{name}}" {{#if (noctisEq name ../st.nature)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <label><span>{{localize "NOCTIS.ui.Attitude"}}</span><select name="st.demeanor"><option value="">—</option>{{#each archetypes}}<option value="{{name}}" {{#if (noctisEq name ../st.demeanor)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <p class="desc">{{natureDesc}}</p><p class="desc">{{demeanorDesc}}</p>
      </div>

      <h3 class="noctis-subsection">{{localize "NOCTIS.ui.Voie"}}</h3>
      <p class="hint">{{localize "NOCTIS.ui.LaVoieEstLaMoraleQui"}}</p>
      <select name="st.roadId"><option value="">{{localize "NOCTIS.ui.ChoisirUneVoie"}}</option>{{#each roads}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
      {{#if road}}<p class="desc">{{{localize "NOCTIS.ui.Vertus2" name=road.name latin=road.system.latin}}} {{#with virtues}}{{localize "NOCTIS.ui.Et" label=this.[0].label label2=this.[1].label}}{{/with}}.</p>{{/if}}
    {{/if}}

    {{!-- ===================== 2. ATTRIBUTS ===================== --}}
    {{#if (noctisEq step 2)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeIiLesAttributs"}}</span></h2>
      <p class="lead">{{{localize "NOCTIS.ui.ChaqueAttributCommenceA1Point"}}}{{#if noAppearance}} {{localize "NOCTIS.ui.FaiblesseDeLigneeLApparenceReste"}}{{/if}}</p>
      <div class="cgrid three">
        {{#each attrGroups}}
          <div class="cgroup {{#if ok}}ok{{/if}}">
            <h3>{{label}}</h3>
            <select name="st.attrRank.{{key}}">{{noctisOptions ../rankChoices rank}}</select>
            <div class="counter">{{#if (noctisEq points null)}}—{{else}}{{{localize "NOCTIS.ui.Restants" left=left points=points}}}{{/if}}</div>
            {{#each traits}}
              <div class="ctrait" data-base="{{base}}" data-bonus="{{bonus}}">
                <span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span>
                {{noctisDots value=value max=5 path=path locked=locked}}
                {{#if bonus}}<em class="b">{{{localize "NOCTIS.ui.Bonus" bonus=bonus}}}{{/if}}
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
      <p class="hint">{{localize "NOCTIS.ui.ForceDexteriteVigueurPourLeCorps"}}</p>
    {{/if}}

    {{!-- ===================== 3. CAPACITÉS ===================== --}}
    {{#if (noctisEq step 3)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeIiiLesCapacites"}}</span></h2>
      <p class="lead">{{{localize "NOCTIS.ui.ClassezTalentsCompetencesEtConnaissances"}}}</p>
      <div class="cgrid three">
        {{#each abilGroups}}
          <div class="cgroup {{#if ok}}ok{{/if}}">
            <h3>{{label}}</h3>
            <select name="st.abilRank.{{key}}">{{noctisOptions ../rankChoices rank}}</select>
            <div class="counter">{{#if (noctisEq points null)}}—{{else}}{{{localize "NOCTIS.ui.Restants" left=left points=points}}}{{/if}}</div>
            {{#each traits}}
              <div class="ctrait" data-base="0" data-bonus="{{bonus}}">
                <span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span>
                {{noctisDots value=value max=5 path=path}}
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
    {{/if}}

    {{!-- ===================== 4. AVANTAGES ===================== --}}
    {{#if (noctisEq step 4)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeIvLesAvantages"}}</span></h2>
      <div class="cgrid three adv">
        <div class="cgroup {{#if (noctisEq discSpent 4)}}ok{{/if}}">
          <h3>{{localize "NOCTIS.ui.Disciplines"}}</h3>
          <div class="counter"><b>{{discSpent}}</b> / 4</div>
          <p class="hint">{{#if guided}}{{localize "NOCTIS.ui.4PointsParmiLesDisciplinesDe"}}{{else}}{{localize "NOCTIS.ui.ToutesLesDisciplinesSontProposees"}}{{/if}}</p>
          {{#each disciplines}}
            <div class="ctrait disc" data-base="0" data-bonus="{{bonus}}">
              <img src="{{img}}" alt=""><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}{{#unless inClan}} {{{localize "NOCTIS.ui.HorsClan"}}}{{/unless}}</span>
              {{noctisDots value=value max=5 path=path}}
            </div>
          {{/each}}
          {{#unless disciplines.length}}<p class="hint">{{localize "NOCTIS.ui.ChoisissezDAbordUnClan"}}</p>{{/unless}}
        </div>
        <div class="cgroup {{#if (noctisEq bgSpent 5)}}ok{{/if}}">
          <h3>{{localize "NOCTIS.ui.Historiques"}}</h3>
          <div class="counter"><b>{{bgSpent}}</b> / 5</div>
          <p class="hint">{{localize "NOCTIS.ui.GenerationAbaisseVotreGeneration12ePar"}}</p>
          {{#each backgrounds}}
            <div class="ctrait" data-base="0" data-bonus="{{bonus}}"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span>{{noctisDots value=value max=5 path=path}}</div>
          {{/each}}
        </div>
        <div class="cgroup {{#if (noctisEq virtSpent 7)}}ok{{/if}}">
          <h3>{{localize "NOCTIS.ui.Vertus"}}</h3>
          <div class="counter"><b>{{virtSpent}}</b> / 7</div>
          <p class="hint">{{localize "NOCTIS.ui.ChaqueVertuCommenceA1Les"}}</p>
          {{#each virtues}}
            <div class="ctrait" data-base="1" data-bonus="{{bonus}}"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span>{{noctisDots value=value max=5 path=path}}</div>
          {{/each}}
          <p class="derived">{{{localize "NOCTIS.ui.GenerationReserveMaxTour" generationLabel=generationLabel blood=gs.blood perTurn=gs.perTurn}}}</p>
        </div>
      </div>
    {{/if}}

    {{!-- ===================== 5. TOUCHES FINALES ===================== --}}
    {{#if (noctisEq step 5)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeVLesTouchesFinales"}}</span></h2>
      <div class="finals">
        <div class="final-card"><span class="l">{{#if road}}{{road.name}}{{else}}{{localize "NOCTIS.ui.Voie"}}{{/if}}</span><span class="n">{{roadBase}}</span><span class="f">= {{virtues.[0].label}} + {{virtues.[1].label}}</span></div>
        <div class="final-card"><span class="l">{{localize "NOCTIS.ui.Volonte"}}</span><span class="n">{{willBase}}</span><span class="f">{{localize "NOCTIS.ui.Courage3"}}</span></div>
        <div class="final-card"><span class="l">{{localize "NOCTIS.ui.Generation"}}</span><span class="n">{{generation}}e</span><span class="f">{{localize "NOCTIS.ui.MaxTraits" maxTrait=gs.maxTrait}}</span></div>
        <div class="final-card blood">
          <span class="l">{{localize "NOCTIS.ui.SangDeDepart"}}</span>
          {{#if (noctisEq bloodStart null)}}<button type="button" data-action="rollBlood"><i class="fa-solid fa-dice-d10"></i> {{localize "NOCTIS.ui.Lancer1d10"}}</button>
          {{else}}<span class="n">{{bloodStart}}</span><span class="f">{{localize "NOCTIS.ui.DeDomaineTroupeauMax" bloodRoll=st.bloodRoll blood=gs.blood}}</span>{{/if}}
        </div>
      </div>
      <p class="lead">{{localize "NOCTIS.ui.UnNiveauDeVoieDe5"}}</p>
    {{/if}}

    {{!-- ===================== 6. BONUS ===================== --}}
    {{!-- ===================== 6. ATOUTS ET HANDICAPS ===================== --}}
    {{#if (noctisEq step 6)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeViAtoutsEtHandicaps"}}</span></h2>
      <p class="lead">{{localize "NOCTIS.ui.FacultatifsLes"}} <b class="mf-word merit">{{{localize "NOCTIS.ui.AtoutsCoutentDesPointsDeBonus"}}} <b class="mf-word flaw">{{{localize "NOCTIS.ui.HandicapsEnRapportent7AuMaximum"}}}</p>
      <div class="mf-totals">
        <span class="merit">{{{localize "NOCTIS.ui.AtoutsPtS" meritCost=meritCost}}}</span>
        <span class="flaw">{{{localize "NOCTIS.ui.HandicapsPtS" flawRaw=flawRaw}}}{{#if (noctisGt flawRaw 7)}} {{{localize "NOCTIS.ui.7Comptes"}}}{{/if}}</span>
        <span>{{localize "NOCTIS.ui.PointsDeBonusRestants2"}} <b class="{{#if (noctisGt 0 bonusLeft)}}warn{{/if}}">{{bonusLeft}}</b> / {{bonusTotal}}</span>
      </div>
      {{#each mfSections}}
        <section class="mf-section">
          <h3 class="mf-cat"><span class="mf-icon">{{icon}}</span> {{label}}</h3>
          <div class="mf-cols">
            <div class="mf-col">
              {{#each merits}}{{> mfCard}}{{/each}}
              {{#unless merits.length}}<p class="hint">{{localize "NOCTIS.ui.AucunAtoutDeCeType"}}</p>{{/unless}}
            </div>
            <div class="mf-col">
              {{#each flaws}}{{> mfCard}}{{/each}}
              {{#unless flaws.length}}<p class="hint">{{localize "NOCTIS.ui.AucunHandicapDeCeType"}}</p>{{/unless}}
            </div>
          </div>
        </section>
      {{/each}}
    {{/if}}

    {{!-- ===================== 7. POINTS DE BONUS ===================== --}}
    {{#if (noctisEq step 7)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.EtapeViiPointsDeBonus"}}</span></h2>
      <p class="lead">{{{localize "NOCTIS.ui.VousDisposezDe15PointsDe"}}}{{#if flawGain}}{{{localize "NOCTIS.ui.PlusGagnesParVosHandicaps7" flawGain=flawGain}}}{{/if}}{{localize "NOCTIS.ui.CoutsAttribut5Capacite2Discipline"}}</p>
      <div class="bonus-summary">{{{localize "NOCTIS.ui.DepensesEnTraitsEnAtoutsReste" bonusSpent=bonusSpent meritCost=meritCost}}} <b class="{{#if (noctisGt 0 bonusLeft)}}warn{{/if}}">{{bonusLeft}}</b></div>
      <div class="cgrid three bonus-grid">
        <div class="cgroup">
          <h3>{{localize "NOCTIS.ui.Attributs5"}}</h3>
          {{#each attrGroups}}{{#each traits}}{{#unless locked}}
            <div class="brow"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span><b>{{value}}</b>
              <a data-action="bonus" data-group="attributes" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="attributes" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          {{/unless}}{{/each}}{{/each}}
          <h3>{{localize "NOCTIS.ui.Vertus22"}}</h3>
          {{#each virtues}}
            <div class="brow"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span><b>{{value}}</b>
              <a data-action="bonus" data-group="virtues" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="virtues" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          {{/each}}
          <div class="brow"><span class="tip" data-tooltip-html="{{roadTip}}" data-tooltip-direction="RIGHT">{{localize "NOCTIS.ui.Voie2"}}</span><b>{{roadValue}}</b>
            <a data-action="bonus" data-group="road" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="road" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          <div class="brow"><span class="tip" data-tooltip-html="{{willTip}}" data-tooltip-direction="RIGHT">{{localize "NOCTIS.ui.Volonte1"}}</span><b>{{willValue}}</b>
            <a data-action="bonus" data-group="willpower" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="willpower" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
        </div>
        <div class="cgroup">
          <h3>{{localize "NOCTIS.ui.Capacites2"}}</h3>
          {{#each abilGroups}}{{#each traits}}
            <div class="brow"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span><b>{{value}}</b>
              <a data-action="bonus" data-group="abilities" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="abilities" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          {{/each}}{{/each}}
        </div>
        <div class="cgroup">
          <h3>{{localize "NOCTIS.ui.Disciplines7"}}</h3>
          {{#each disciplines}}
            <div class="brow"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span><b>{{value}}</b>
              <a data-action="bonus" data-group="disciplines" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="disciplines" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          {{/each}}
          <h3>{{localize "NOCTIS.ui.Historiques1"}}</h3>
          {{#each backgrounds}}
            <div class="brow"><span class="tip" data-tooltip-html="{{tip}}" data-tooltip-direction="RIGHT">{{label}}</span><b>{{value}}</b>
              <a data-action="bonus" data-group="backgrounds" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="bonus" data-group="backgrounds" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{!-- ===================== 8. RÉSUMÉ ===================== --}}
    {{#if (noctisEq step 8)}}
      <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.LEtincelleDeNonVie"}}</span></h2>
      <div class="summary-head">
        {{#if clan}}<img src="{{clan.system.emblem}}" alt="">{{/if}}
        <div><h3>{{st.name}}</h3><p>{{#if clan}}{{clan.name}} · {{/if}}{{localize "NOCTIS.ui.Generation2" generationLabel=generationLabel}} {{#if road}}{{road.name}} {{roadValue}}{{/if}}</p>
        <p>{{{localize "NOCTIS.ui.NatureAttitude" concept=st.concept nature=st.nature demeanor=st.demeanor}}}</p></div>
      </div>
      <div class="cgrid three summary">
        {{#each attrGroups}}<div><h4>{{label}}</h4>{{#each traits}}<div class="srow">{{label}} <b>{{value}}</b></div>{{/each}}</div>{{/each}}
      </div>
      <div class="cgrid three summary">
        <div><h4>{{localize "NOCTIS.ui.Disciplines"}}</h4>{{#each disciplines}}{{#if value}}<div class="srow">{{label}} <b>{{value}}</b></div>{{/if}}{{/each}}</div>
        <div><h4>{{localize "NOCTIS.ui.Historiques"}}</h4>{{#each backgrounds}}{{#if value}}<div class="srow">{{label}} <b>{{value}}</b></div>{{/if}}{{/each}}</div>
        <div><h4>{{localize "NOCTIS.ui.Vertus"}}</h4>{{#each virtues}}<div class="srow">{{label}} <b>{{value}}</b></div>{{/each}}<div class="srow">{{{localize "NOCTIS.ui.Volonte2" willValue=willValue}}}</div>{{#if bloodStart}}<div class="srow">{{{localize "NOCTIS.ui.Sang" bloodStart=bloodStart}}}</div>{{/if}}</div>
      </div>
      {{#if hasChosenMF}}
        <div class="summary mf-summary"><h4>{{localize "NOCTIS.ui.AtoutsEtHandicaps"}}</h4>
          {{#each chosenMF}}<div class="srow mf-{{kind}}">{{icon}} {{name}} <b>{{level}}</b></div>{{/each}}
        </div>
      {{/if}}
      {{#if allErrors.length}}
        <div class="errors"><h4>{{#if guided}}{{localize "NOCTIS.ui.ACorrigerAvantDeCreer"}}{{else}}{{localize "NOCTIS.ui.EcartsAvecLesReglesModeLibre"}}{{/if}}</h4><ul>{{#each allErrors}}<li>{{this}}</li>{{/each}}</ul></div>
      {{/if}}
      <div class="finish-row"><button type="button" class="big" data-action="finish"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.CreerLePersonnage"}}</button></div>
    {{/if}}

    {{#if stepErrors.length}}{{#unless (noctisEq step 8)}}
      <ul class="step-errors">{{#each stepErrors}}<li><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</li>{{/each}}</ul>
    {{/unless}}{{/if}}
  </section>

  {{#if modeChosen}}
  <footer class="creator-nav">
    {{#unless isFirst}}<button type="button" data-action="prev"><i class="fa-solid fa-arrow-left"></i> {{localize "NOCTIS.ui.Precedent"}}</button>{{/unless}}
    <span class="spacer"></span>
    {{#unless isLast}}<button type="button" data-action="next">{{localize "NOCTIS.ui.Suivant"}} <i class="fa-solid fa-arrow-right"></i></button>{{/unless}}
  </footer>
  {{/if}}
</div>
