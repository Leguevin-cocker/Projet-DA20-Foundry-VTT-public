<div class="ledger">
  <nav class="dash-tabs">
    <a class="{{#if isXp}}active{{/if}}" data-action="setTab" data-tab="xp"><i class="fa-solid fa-scroll"></i> {{localize "NOCTIS.ui.Experience"}}</a>
    <a class="{{#if isBlood}}active{{/if}}" data-action="setTab" data-tab="blood"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.Sang2"}}</a>
    <a class="{{#if isMoral}}active{{/if}}" data-action="setTab" data-tab="moral"><i class="fa-solid fa-scale-balanced"></i> {{localize "NOCTIS.moral.Roads"}}</a>
  </nav>
{{#if isMoral}}
  <p class="hint moral-intro">{{localize "NOCTIS.moral.DashIntro"}}</p>
  <div class="moral-board ledger-table-wrap">
    {{#each moralPcs}}
      <article class="moral-pc" data-actor-id="{{id}}">
        <header>
          <a data-action="openMoral" data-tooltip="{{localize "NOCTIS.moral.OpenTab"}}"><img src="{{img}}" alt=""></a>
          <div class="mp-id"><b>{{name}}</b><small>{{clan}}</small></div>
          <div class="mp-score"><span>{{value}}</span><div class="mor-dots">{{#each dots}}<i class="{{#if filled}}on{{/if}}"></i>{{/each}}</div></div>
        </header>
        <p class="mp-road"><b>{{road}}</b>{{#if creed}} · {{creed}}{{/if}}</p>
        <div class="mp-facts">
          <span class="aura {{#if aura.good}}good{{/if}}{{#if aura.bad}}bad{{/if}}" data-tooltip="{{aura.rolls}}"><i class="fa-solid fa-masks-theater"></i> {{aura.name}} <b>{{aura.modLabel}}</b></span>
          <span><i class="fa-solid fa-moon"></i> {{wake}}</span>
          <span><i class="fa-solid fa-dice-d20"></i> {{localize "NOCTIS.moral.CapValue" n=value}}</span>
          <span><i class="fa-solid fa-ban"></i> {{risk}}</span>
        </div>
        <p class="mp-virtues">{{#each virtues}}<span>{{label}} <b>{{value}}</b></span>{{/each}}</p>
        {{#if nextSin}}<p class="mp-next"><i class="fa-solid fa-skull"></i> {{localize "NOCTIS.moral.NextSin" sin=nextSin}}</p>{{/if}}
        {{#each alerts}}<p class="alert"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
        <ol class="mp-log">
          {{#each recent}}<li class="{{#if up}}up{{/if}}{{#if down}}down{{/if}}"><i class="{{icon}}"></i> <b>{{kindLabel}}</b>{{#if deltaLabel}} {{deltaLabel}}{{/if}} — {{text}} <em>{{date}}</em></li>{{else}}<li class="empty">{{localize "NOCTIS.moral.JournalEmptyShort"}}</li>{{/each}}
        </ol>
        <footer>
          <span class="mp-count">{{localize "NOCTIS.moral.Counts" gains=gains losses=losses n=logCount}}</span>
          <a data-action="moralSin" data-tooltip="{{localize "NOCTIS.moral.SinCommitted"}}"><i class="fa-solid fa-skull"></i></a>
          <a data-action="moralEpiphany" data-tooltip="{{localize "NOCTIS.moral.Kind.epiphany"}}"><i class="fa-solid fa-sun"></i></a>
          <a data-action="moralNote" data-tooltip="{{localize "NOCTIS.moral.NoteTip"}}"><i class="fa-solid fa-feather"></i></a>
        </footer>
      </article>
    {{else}}
      <p class="empty">{{localize "NOCTIS.moral.NoPcs"}}</p>
    {{/each}}
  </div>
{{/if}}
{{#if isXp}}
  <section class="ledger-award">
    <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.AttribuerDeLExperience"}}</span></h2>
    <div class="award-row">
      <label><span>{{localize "NOCTIS.ui.MontantPourChacun"}}</span><input type="number" name="award.amount" value="3" min="0" max="50"></label>
      <label class="grow"><span>{{localize "NOCTIS.ui.Motif"}}</span><input type="text" name="award.label" placeholder="{{localize "NOCTIS.ui.ExSeance12LaChuteDe"}}"></label>
      <label class="check"><input type="checkbox" name="award.whisper" checked> {{localize "NOCTIS.ui.PrevenirChaqueJoueurMessagePrive"}}</label>
      <button type="button" data-action="award" class="award-btn"><i class="fa-solid fa-gift"></i> {{localize "NOCTIS.ui.Attribuer"}}</button>
    </div>
    <p class="hint">{{localize "NOCTIS.ui.CochezLesPersonnagesConcernesLaColonne"}}</p>
  </section>

  {{#unless flagged}}<p class="ledger-warn"><i class="fa-solid fa-flag"></i> {{{localize "NOCTIS.ui.AucunPersonnageNEstMarquePj"}}}</p>{{/unless}}

  <div class="ledger-table-wrap">
    <table class="ledger-table">
      <thead><tr>
        <th><a data-action="toggleAll" data-tooltip="{{localize "NOCTIS.ui.ToutCocherDecocher"}}"><i class="fa-solid fa-check-double"></i></a></th>
        <th>{{localize "NOCTIS.ui.Personnage"}}</th><th class="num">{{localize "NOCTIS.ui.Gagne"}}</th><th class="num">{{localize "NOCTIS.ui.Depense"}}</th><th class="num">{{localize "NOCTIS.ui.Dispo"}}</th><th class="bar-col">{{localize "NOCTIS.ui.Repartition"}}</th><th class="num">{{localize "NOCTIS.ui.Bonus2"}}</th>
      </tr></thead>
      <tbody>
        {{#each pcs}}
          <tr data-actor-id="{{id}}">
            <td><input type="checkbox" class="pc-check" checked></td>
            <td class="who">
              <a data-action="openSheet" data-tooltip="{{localize "NOCTIS.ui.OuvrirLaFiche"}}"><img src="{{img}}" alt=""></a>
              <span class="who-text"><b>{{name}}</b><em>{{player}}{{#if online}} · <i class="fa-solid fa-circle online" data-tooltip="{{localize "NOCTIS.ui.Connecte"}}"></i>{{/if}}</em>{{{localize "NOCTIS.ui.DernierGain" lastGain=lastGain}}}
              {{#each alerts}}<span class="alert"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</span>{{/each}}</span>
            </td>
            <td class="num">{{gained}}</td>
            <td class="num">{{spent}}</td>
            <td class="num avail {{#if (noctisGt 0 available)}}neg{{/if}}">{{available}}</td>
            <td class="bar-col"><div class="xp-bar">{{#each segments}}<span class="seg {{cls}}" style="width: {{pct}}%" data-tooltip="{{tip}}"></span>{{/each}}</div></td>
            <td class="num"><input type="number" class="pc-bonus" value="0" min="-20" max="20"></td>
          </tr>
        {{else}}
          <tr><td colspan="7" class="empty">{{localize "NOCTIS.ui.AucunPersonnageJoueurTrouve"}}</td></tr>
        {{/each}}
      </tbody>
      {{#if hasPcs}}
      <tfoot><tr><td></td><td>{{localize "NOCTIS.ui.TotalDeLaCoterie"}}</td><td class="num">{{totals.gained}}</td><td class="num">{{totals.spent}}</td><td class="num">{{totals.available}}</td><td colspan="2"></td></tr></tfoot>
      {{/if}}
    </table>
    <div class="ledger-legend">
      {{#each families}}<span><i class="sw {{key}}"></i> {{label}}</span>{{/each}}
      <span><i class="sw avail"></i> {{localize "NOCTIS.ui.Disponible"}}</span>
    </div>
  </div>

  <section class="ledger-history">
    <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.Distributions"}}</span></h2>
    {{#each history}}
      <div class="batch">
        <span class="b-date">{{date}}</span>
        <span class="b-label"><b>{{label}}</b><small>{{summary}}</small></span>
        <a class="b-undo" data-action="undoBatch" data-batch="{{id}}" data-tooltip="{{localize "NOCTIS.ui.RetirerCetteDistributionDesFiches"}}"><i class="fa-solid fa-rotate-left"></i> {{localize "NOCTIS.ui.Annuler"}}</a>
      </div>
    {{else}}
      <p class="empty">{{localize "NOCTIS.ui.AucuneDistributionPourLInstant"}}</p>
    {{/each}}
  </section>
{{/if}}

{{#if isBlood}}
  <section class="ledger-award blood-award">
    <h2 class="noctis-section"><span>{{localize "NOCTIS.ui.DonnerOuRetirerDuSang"}}</span></h2>
    <div class="award-row">
      <label><span>{{localize "NOCTIS.ui.PointsDeSang"}}</span><input type="number" name="blood.amount" value="2" min="0" max="50"></label>
      <label class="grow"><span>{{localize "NOCTIS.ui.Motif"}}</span><input type="text" name="blood.reason" placeholder="{{localize "NOCTIS.ui.ExChasseAuPortCaliceDu"}}"></label>
      <label class="check"><input type="checkbox" name="blood.whisper" checked> {{localize "NOCTIS.ui.PrevenirChaqueJoueurMessagePrive"}}</label>
    </div>
    <div class="award-row blood-buttons">
      <button type="button" data-action="bloodGive" data-mode="add" class="award-btn"><i class="fa-solid fa-droplet"></i> {{localize "NOCTIS.ui.AjouterAuxCoches"}}</button>
      <button type="button" data-action="bloodGive" data-mode="remove"><i class="fa-solid fa-droplet-slash"></i> {{localize "NOCTIS.ui.RetirerAuxCoches"}}</button>
      <button type="button" data-action="bloodGive" data-mode="fill"><i class="fa-solid fa-fill-drip"></i> {{localize "NOCTIS.ui.RemplirLesCoches"}}</button>
      <button type="button" data-action="bloodNightfall" data-tooltip="{{localize "NOCTIS.ui.Vampires1SangTous1Volonte"}}"><i class="fa-solid fa-moon"></i> {{localize "NOCTIS.ui.TombeeDeLaNuit"}}</button>
    </div>
    <p class="hint">{{localize "NOCTIS.ui.LesReservesRestentBorneesEntre0"}}</p>
  </section>

  {{#unless flagged}}<p class="ledger-warn"><i class="fa-solid fa-flag"></i> {{localize "NOCTIS.ui.AucunPersonnageNEstMarquePj2"}}</p>{{/unless}}

  <div class="ledger-table-wrap">
    <table class="ledger-table blood-table">
      <thead><tr>
        <th><a data-action="toggleAll" data-tooltip="{{localize "NOCTIS.ui.ToutCocherDecocher"}}"><i class="fa-solid fa-check-double"></i></a></th>
        <th>{{localize "NOCTIS.ui.Personnage"}}</th><th class="num">{{localize "NOCTIS.ui.Sang2"}}</th><th class="bar-col">{{localize "NOCTIS.ui.Reserve"}}</th><th class="num">{{localize "NOCTIS.ui.Tour"}}</th><th class="steps">{{localize "NOCTIS.ui.Ajuster"}}</th>
      </tr></thead>
      <tbody>
        {{#each bloodPcs}}
          <tr data-actor-id="{{id}}">
            <td><input type="checkbox" class="pc-check" checked></td>
            <td class="who">
              <a data-action="openSheet" data-tooltip="{{localize "NOCTIS.ui.OuvrirLaFiche"}}"><img src="{{img}}" alt=""></a>
              <span class="who-text"><b>{{name}}</b><em>{{player}}{{#if online}} · <i class="fa-solid fa-circle online" data-tooltip="{{localize "NOCTIS.ui.Connecte"}}"></i>{{/if}}</em><small>{{kind}}</small>
              {{#if hunger}}<span class="alert"><i class="fa-solid fa-triangle-exclamation"></i> {{hunger}}</span>{{/if}}</span>
            </td>
            <td class="num blood-num {{level}}">{{value}}<small>/{{max}}</small></td>
            <td class="bar-col"><div class="blood-bar {{level}}" data-tooltip="{{localize "NOCTIS.ui.IlManque" value=value max=max pct=pct missing=missing}}"><span style="width: {{pct}}%"></span></div></td>
            <td class="num">{{perTurn}}</td>
            <td class="steps">
              <a data-action="bloodStep" data-delta="-1">−1</a><a data-action="bloodStep" data-delta="1">+1</a><a data-action="bloodStep" data-delta="5">+5</a>
              <a data-action="bloodFill" class="fill" data-tooltip="{{localize "NOCTIS.ui.RemplirLaReserve"}}"><i class="fa-solid fa-fill-drip"></i></a>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="6" class="empty">{{localize "NOCTIS.ui.AucunPersonnageJoueurNeSeNourrit"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{/if}}
</div>
