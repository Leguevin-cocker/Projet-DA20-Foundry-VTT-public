<div class="ws">
  <nav class="ws-kinds">
    {{#each kinds}}
      <a class="{{#if active}}active{{/if}}" data-action="kind" data-kind="{{key}}"><i class="{{icon}}"></i> <span>{{label}}</span> <b>{{count}}</b></a>
    {{/each}}
    <div class="ws-export">
      <button type="button" data-action="exportAll" data-tooltip="{{localize "NOCTIS.ui.CopieToutLeContenuDuMonde"}}"><i class="fa-solid fa-box-archive"></i> {{localize "NOCTIS.ui.RangerDansUnCompendium" worldCount=worldCount}}</button>
    </div>
  </nav>
  <section class="ws-main">
    <header class="ws-head">
      <h2><i class="{{current.icon}}"></i> {{current.label}}</h2>
      <p>{{current.help}}</p>
      <div class="ws-create">
        {{#each createTypes}}<button type="button" data-action="create" data-type="{{type}}"><i class="fa-solid fa-plus"></i> {{label}}</button>{{/each}}
      </div>
    </header>
    <ul class="ws-list">
      {{#each list}}
        <li data-uuid="{{uuid}}" class="{{#if world}}world{{else}}pack{{/if}}">
          <img src="{{img}}" alt="">
          <a class="ws-name" data-action="open">{{name}}</a>
          <span class="ws-type">{{typeLabel}}</span>
          <small class="ws-info">{{info}}</small>
          <span class="ws-src" data-tooltip="{{#if world}}{{localize "NOCTIS.ui.ObjetDuMondeModifiable"}}{{else}}{{localize "NOCTIS.ui.CompendiumCopiezLeDansLeMonde"}}{{/if}}">{{source}}</span>
          <span class="ws-ctrl">
            <a data-action="open" data-tooltip="{{localize "NOCTIS.ui.Ouvrir"}}"><i class="fa-solid fa-pen-to-square"></i></a>
            {{#unless world}}<a data-action="copy" data-tooltip="{{localize "NOCTIS.ui.CopierDansLeMonde"}}"><i class="fa-solid fa-copy"></i></a>{{/unless}}
            {{#if world}}<a data-action="remove" data-tooltip="{{localize "NOCTIS.ui.Supprimer"}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
      {{else}}
        <li class="empty">{{localize "NOCTIS.ui.RienPourLInstantCreezVotre"}}</li>
      {{/each}}
    </ul>
    <p class="ws-foot">{{{localize "NOCTIS.ui.LeCreateurDePersonnageEtLes"}}}</p>
  </section>
</div>
